 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1, RELSET_1,
      XTUPLE_0, PARTFUN1, MCART_1, FUNCT_2, BINOP_1, DOMAIN_1, CARD_3, NUMBERS,
      MEMBERED, XXREAL_3, XCMPLX_0, XXREAL_0, SQUARE_1, XREAL_0, RAT_1, NAT_1,
      VALUED_1, COMSEQ_2, XXREAL_2, EXTREAL1, COMPLEX1, MESFUNC1, FCONT_1,
