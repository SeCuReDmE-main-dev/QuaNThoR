environ

 vocabularies NUMBERS, NAT_1, RELAT_1, FUNCT_1, XXREAL_0, ARYTM_3, XCMPLX_0,
      CARD_1, INT_1, NEWTON, ARYTM_1, SUBSET_1, XBOOLE_0, TARSKI, ORDINAL1,
      FINSET_1, ABIAN, MEMBERED, MOEBIUS1, REAL_1, INT_2, PBOOLE, SQUARE_1,
      ZFMISC_1, ORDINAL4, NAT_LAT, FINSEQ_1, INT_6, CARD_3, VALUED_0, PARTFUN3,
      PRE_POLY, ORDINAL2, FUNCT_7, VALUED_1, FUNCT_2, NUMBER06, FINSEQ_2,
      POWER, AFINSQ_1, PRGCOR_2, NUMBER10, COMPLFLD, STRUCT_0, PARTFUN1,
      SETWISEO, BINOP_2, ALGSTR_0, PREPOWER, NEWTON04, NUMBER14, NUMBER15;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, DOMAIN_1, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
      PBOOLE, FINSET_1, MEMBERED, VALUED_0, VALUED_1, XREAL_0, INT_1, INT_2,
      NAT_1, NAT_D, XXREAL_0, BINOP_2, SETWOP_2, SQUARE_1, AFINSQ_1, FINSEQ_1,
      PARTFUN3, FINSEQ_2, RVSUM_1, PREPOWER, POWER, NEWTON, ABIAN, PRE_POLY,
      NAT_3, NEWTON04, NAT_LAT, STRUCT_0, ALGSTR_0, GROUP_4, COMPLFLD,
      MOEBIUS1, INT_6, NUMBER06, NUMBER10, NUMBER14;
 constructors NAT_D, ABIAN, PEPIN, NAT_3, MOEBIUS1, WELLORD2, NEWTON03, POWER,
      DOMAIN_1, EC_PF_2, NUMBER06, WSIERP_1, CALCUL_2, AFINSQ_1, NUMBER10,
      COMPLFLD, BINOP_2, GROUP_4, FINSOP_1, PREPOWER, NEWTON04, RVSUM_2,
      NUMBER14;
 registrations ORDINAL1, RELSET_1, FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0,
      XREAL_0, NAT_1, INT_1, MEMBERED, VALUED_0, CARD_1, NEWTON, NEWTON02,
      NEWTON03, ABIAN, NAT_6, JORDAN1D, WSIERP_1, NEWTON01, FINSEQ_1, RVSUM_1,
      PRE_POLY, FUNCT_1, RELAT_1, XBOOLE_0, NAT_3, SUBSET_1, MOEBIUS1,
      PYTHTRIP, VALUED_1, PARTFUN3, FINSEQ_9, RAMSEY_1, SQUARE_1, POWER,
      NUMBER08, RVSUM_4, NUMBER09, NEWTON04, COMPLEX3, AFINSQ_1, FINSEQ_2,
      FOMODEL0, COMPLFLD, INT_6, NAT_LAT, NUMBER03, EUCLID_9, NUMBER14,
      AOFA_000, NUMBER06, NUMBER10;
 requirements REAL, NUMERALS, BOOLE, SUBSET, ARITHM;


begin

reserve a,b,k,m,n,s for Nat;
reserve c,c1,c2,c3 for Complex;
reserve i,j,z for Integer;
reserve p for Prime;
reserve x for object;

registration
  let p be Prime;
  reduce In(p,SetPrimes) to p;
end;

registration
  let a,b,c,d be Integer;
  reduce In([a,b,c,d],[:INT,INT,INT,INT:]) to [a,b,c,d];
end;

registration
  let n;
  cluster positive-yielding natural-valued n-element for FinSequence;
end;

registration
  cluster non-empty natural-valued -> positive-yielding for Relation;
end;

registration
  let D be set;
  let f be D-valued XFinSequence;
  cluster XFS2FS(f) -> D-valued;
end;

theorem :: NUMBER15:1
  for f being XFinSequence st n in dom XFS2FS(f) holds n-1 in dom f;

registration
  let f be increasing ext-real-valued XFinSequence;
  cluster XFS2FS(f) -> increasing;
end;

registration
  let f be decreasing ext-real-valued XFinSequence;
  cluster XFS2FS(f) -> decreasing;
end;

registration
  let f be non-increasing ext-real-valued XFinSequence;
  cluster XFS2FS(f) -> non-increasing;
end;

registration
  let f be non-decreasing ext-real-valued XFinSequence;
  cluster XFS2FS(f) -> non-decreasing;
end;

registration
  let r be positive Real;
  let f be positive-yielding real-valued Function;
  cluster r(#)f -> positive-yielding;
end;

registration
  let r be positive Real;
  let f be increasing real-valued Function;
  cluster r(#)f -> increasing;
end;

registration
  let r be negative Real;
  let f be increasing real-valued Function;
  cluster r(#)f -> decreasing;
end;

registration
  let r be positive Real;
  let f be decreasing real-valued Function;
  cluster r(#)f -> decreasing;
end;

registration
  let r be negative Real;
  let f be decreasing real-valued Function;
  cluster r(#)f -> increasing;
end;

registration
  let r be positive Real;
  let f be non-increasing real-valued Function;
  cluster r(#)f -> non-increasing;
end;

registration
  let r be negative Real;
  let f be non-increasing real-valued Function;
  cluster r(#)f -> non-decreasing;
end;

registration
  let r be positive Real;
  let f be non-decreasing real-valued Function;
  cluster r(#)f -> non-decreasing;
end;

registration
  let r be negative Real;
  let f be non-decreasing real-valued Function;
  cluster r(#)f -> non-increasing;
end;

theorem :: NUMBER15:2
  for f being finite-support Function holds rng f c= rng(f|support f) \/ {0};

registration
  let f be finite-support Function;
  cluster rng f -> finite;
end;

theorem :: NUMBER15:3
  for f being complex-valued FinSequence
  for g being FinSequence of F_Complex st f = g holds
  Product f = Product g;

theorem :: NUMBER15:4
  for a being Complex, p,q being complex-valued FinSequence st
  len p = len q &
  ex i being Nat st i in dom p & q.i = a * p.i &
  for j being Nat st j in dom p & i <> j holds q.j = p.j
  holds Product q = a * Product p;

begin :: Problem 38

theorem :: NUMBER15:5
  n mod 4 = 0 or n mod 4 = 2 implies (n * m) mod 4 = 0 or (n * m) mod 4 = 2;

theorem :: NUMBER15:6
  n * m mod 4 = 1 implies n mod 4 = 1 or n mod 4 = 3;

theorem :: NUMBER15:7
  (n * m) mod 4 = 3 implies
  (n mod 4 = 1 & m mod 4 = 3) or (n mod 4 = 3 & m mod 4 = 1);

theorem :: NUMBER15:8
  (n mod 4 = 1 & m mod 4 = 1) or (n mod 4 = 3 & m mod 4 = 3)
  implies n * m mod 4 = 1;

theorem :: NUMBER15:9
  (n mod 4 = 1 & m mod 4 = 3) or (n mod 4 = 3 & m mod 4 = 1)
  implies n * m mod 4 = 3;

theorem :: NUMBER15:10
  p is prime & p mod 4 = 1 & n divides p|^k implies n mod 4 = 1;

theorem :: NUMBER15:11
  p mod 4 = 3 implies p|^(2*n) mod 4 = 1 & p|^(2*n+1) mod 4 = 3;

definition
  let n,m,r be Integer;
  func divisors(n,m,r) -> Subset of NAT equals
:: NUMBER15:def 1
  { k where k is Nat: k mod m = r & k divides n };
end;

theorem :: NUMBER15:12
  for n,m,r being Integer holds
  k in divisors(n,m,r) iff k mod m = r & k divides n;

registration
  let n be positive Nat;
  let m,r be Integer;
  cluster divisors(n,m,r) -> finite;
end;

theorem :: NUMBER15:13
  for n,m,r,p being Integer holds
  k in divisors(n,m,r) \/ divisors(n,m,p)
   iff (k mod m = r or k mod m = p) & k divides n;

theorem :: NUMBER15:14
  for n,m,r being Integer holds
  k <> i implies divisors(n,m,k) misses divisors(n,m,i);

theorem :: NUMBER15:15
  divisors(2|^n,4,3) = {} & divisors(2|^n,4,1) = {1};

theorem :: NUMBER15:16
  for p being Prime, n being Nat
  holds card { k where k is Nat: k divides p|^n } = n + 1;

theorem :: NUMBER15:17
  for p being Prime, n being Nat st p mod 4 = 1 holds
    card divisors(p|^n,4,1) = n+1 &
    card divisors(p|^n,4,3) = 0;

theorem :: NUMBER15:18
  for p being Prime, m,n st p mod 4 = 3
    holds
    divisors(p|^n,4,1)\/divisors(p|^n,4,3) =
      { k where k is Nat: k divides p|^n } &
    (n = 2*m implies
      card divisors(p|^n,4,1) = m+1 & card divisors(p|^n,4,3) = m) &
    (n = 2*m+1 implies
      card divisors(p|^n,4,1) = m+1 & card divisors(p|^n,4,3) = m+1);

theorem :: NUMBER15:19
  p is prime implies p = 2 or p mod 4 = 1 or p mod 4 = 3;

theorem :: NUMBER15:20
  n > 1 implies
   ex p be Prime st p divides n &
     for q be Prime st q divides n holds q <= p;

theorem :: NUMBER15:21
  n is positive & p is prime & p divides n implies
    ex k,m be positive Nat st 0 < k & n = m * p|^k & m,p are_coprime;

theorem :: NUMBER15:22 :: Problem 38 a
  for n being non zero Nat holds card divisors(n,4,3) <= card divisors(n,4,1);

theorem :: NUMBER15:23
  m is even implies 3|^m mod 4 = 1;

theorem :: NUMBER15:24
  m is odd implies 3|^m mod 4 = 3;

theorem :: NUMBER15:25
  for n being Nat holds
  divisors(3|^(2*n+1),4,1) = { 3|^m: m is even & m <= 2*n+1 };

theorem :: NUMBER15:26
  for n being Nat holds
  divisors(3|^(2*n+1),4,3) = { 3|^m where m is Nat: m is odd & m <= 2*n+1 };

theorem :: NUMBER15:27
  card { 3|^m where m is Nat: m is even & m <= 2*n+1 } = n+1;

theorem :: NUMBER15:28
  card { 3|^m where m is Nat: m is odd & m <= 2*n+1 } = n+1;

theorem :: NUMBER15:29
  card divisors(3|^(2*n+1),4,1) = n+1;

theorem :: NUMBER15:30
  card divisors(3|^(2*n+1),4,3) = n+1;

theorem :: NUMBER15:31
  card divisors(3|^(2*n+1),4,1) = card divisors(3|^(2*n+1),4,3);

theorem :: NUMBER15:32
  { n where n is Nat:
    card divisors(3|^(2*n+1),4,1) = card divisors(3|^(2*n+1),4,3)
  } is infinite;

theorem :: NUMBER15:33 :: Problem 38 b
  { n where n is Nat: card divisors(n,4,1) = card divisors(n,4,3) } is infinite
;

theorem :: NUMBER15:34
  k divides 5|^n implies k mod 4 = 1;

theorem :: NUMBER15:35
  not ex k st k mod 4 = 3 & k divides 5|^n;

theorem :: NUMBER15:36
  {k where k is Nat: k divides 5|^n} = divisors(5|^n,4,1);

theorem :: NUMBER15:37
  card {k where k is Nat: k divides 5|^n} = n+1;

theorem :: NUMBER15:38
  divisors(5|^n,4,3) = {};

theorem :: NUMBER15:39
  { n where n is Nat: card divisors(5|^n,4,1) > card divisors(5|^n,4,3) }
  is infinite;

theorem :: NUMBER15:40 :: Problem 38 c
  { n where n is positive Nat: card divisors(n,4,1) > card divisors(n,4,3) }
  is infinite;

begin :: Problem 58

definition
  let X be set;
  attr X is positive-membered means
:: NUMBER15:def 2
  for x being ExtReal st x in X holds x > 0;
end;

registration
  let n be non zero Nat;
  cluster {n} -> positive-membered;
  let m be non zero Nat;
  cluster {m,n} -> positive-membered;
end;

registration
  cluster NAT \ {0} -> positive-membered;
end;

registration
  cluster non empty finite positive-membered for set;
end;

registration
  cluster infinite positive-membered for set;
end;

theorem :: NUMBER15:41
  for A being positive-membered set, B being set st B c= A holds
  B is positive-membered;

registration
  let A be positive-membered set;
  cluster -> positive-membered for Subset of A;
end;

registration
  let X be positive-membered set;
  cluster X-valued -> positive-yielding for Relation;
end;

registration
  let n be Nat;
  cluster Seg(n) -> positive-membered;
end;

registration
  let X be positive-membered set;
  cluster id X -> positive-yielding;
end;

registration
  let n be Nat;
  cluster idseq(n) -> positive-yielding;
end;

registration
  let n be Nat;
  cluster idseq(n) -> increasing;
end;

registration
  cluster SetPrimes -> positive-membered;
end;

definition
  let s be Nat;
  func PrimeNumbersS(s) -> sequence of SetPrimes means
:: NUMBER15:def 3
  for n being Nat holds it.n = primenumber(n);
end;

registration
  let s be Nat;
  cluster PrimeNumbersS(s) -> increasing;
end;

registration
  let s be Nat;
  cluster PrimeNumbersS(s) -> onto;
end;

registration
  let s be Nat;
  cluster PrimeNumbersS(s) | s -> increasing;
end;

definition
  let s be Nat;
  func PrimeNumbersFS(s) -> FinSequence of SetPrimes equals
:: NUMBER15:def 4
  XFS2FS (PrimeNumbersS(s) | s);
end;

theorem :: NUMBER15:42
  for s being Nat holds len PrimeNumbersFS(s) = s;

theorem :: NUMBER15:43
  for n,s being Nat st n < s holds PrimeNumbersFS(s).(n+1) = primenumber(n);

theorem :: NUMBER15:44
  for n being non zero Nat
  for s being Nat st n <= s holds PrimeNumbersFS(s).n = primenumber(n-1);

registration
  let s be Nat;
  cluster PrimeNumbersFS(s) -> increasing;
end;

registration
  let s be Nat;
  cluster PrimeNumbersFS(s) -> positive-yielding;
end;

registration
  let s be non zero Nat;
  cluster PrimeNumbersFS(s) -> non empty;
end;

registration
  let s be non zero Nat;
  cluster PrimeNumbersFS(s) -> Chinese_Remainder;
end;

theorem :: NUMBER15:45
  for k,s being Nat st k < s holds
  Product PrimeNumbersFS(s) / primenumber(k) is Nat;

definition
  let s be Nat;
  func sequenceA(s) -> FinSequence of NAT means
:: NUMBER15:def 5
  len it = s &
  for k being non zero Nat st k <= s holds
  for e being Nat st e = Product PrimeNumbersFS(s) / primenumber(k-1) holds
  it.k = CRT(0, e, -1, primenumber(k-1)) + Product PrimeNumbersFS(s);
end;

registration
  let s be Nat;
  cluster sequenceA(s) -> s-element;
end;

registration
  let s be Nat;
  cluster sequenceA(s) -> positive-yielding;
end;

theorem :: NUMBER15:46
  for k, s being non zero Nat holds
  k <= s implies primenumber(k-1) divides sequenceA(s).k + 1;

theorem :: NUMBER15:47
  for k, n being non zero Nat st k <> n & n <= s & k <= s
  holds primenumber(k-1) divides sequenceA(s).n;

definition
  let f, g be real-valued Function;
  func f to_power g -> Function means
:: NUMBER15:def 6
  dom it = (dom f) /\ (dom g) &
  for x being object st x in dom it holds it.x = (f.x) to_power (g.x);
end;

registration
  let f, g be real-valued FinSequence;
  cluster f to_power g -> FinSequence-like;
end;

registration
  let n be Nat;
  let f, g be n-element real-valued FinSequence;
  cluster f to_power g -> n-element;
end;

registration
  let f, g be real-valued Function;
  cluster f to_power g -> REAL-valued;
end;

registration
  let f be rational-valued Function;
  let g be integer-valued Function;
  cluster f to_power g -> RAT-valued;
end;

registration
  let f be integer-valued Function;
  let g be natural-valued Function;
  cluster f to_power g -> INT-valued;
end;

registration
  let f, g be natural-valued Function;
  cluster f to_power g -> NAT-valued;
end;

registration
  let f, g be positive-yielding real-valued Function;
  cluster f to_power g -> positive-yielding;
end;

definition
  let s be Nat;
  func numberQ(s) -> Nat equals
:: NUMBER15:def 7
  Product (idseq(s) to_power sequenceA(s));
end;

registration
  let s be Nat;
  cluster numberQ(s) -> positive;
end;

definition
  let s be Nat;
  func Problem58Solution(s) -> FinSequence of NAT equals
:: NUMBER15:def 8
  numberQ(s) (#) idseq(s);
end;

registration
  let s be Nat;
  cluster Problem58Solution(s) -> s-element;
end;

theorem :: NUMBER15:48
  1 <= k <= s implies Problem58Solution(s).k = k * numberQ(s);

registration
  let s be Nat;
  cluster Problem58Solution(s) -> increasing positive-yielding;
end;

definition
  let s be Nat;
  func sequenceAk1Pk(s) -> FinSequence of NAT means
:: NUMBER15:def 9
  len it = s &
  for k being non zero Nat st k <= s holds
   it.k = (sequenceA(s).k + 1) / primenumber(k-1);
end;

registration
  let s be Nat;
  cluster sequenceAk1Pk(s) -> s-element;
end;

definition
  let s be Nat;
  let k be non zero Nat such that
 k <= s;
  func sequenceAnPk(s,k) -> FinSequence of NAT means
:: NUMBER15:def 10
  len it = s &
  for n being non zero Nat st n <= s holds
   (n <> k implies it.n = sequenceA(s).n / primenumber(k-1)) &
   (n = k implies it.n = 0);
end;

definition
  let s be Nat;
  func sequenceQk(s) -> FinSequence of NAT means
:: NUMBER15:def 11
  len it = s &
  for k being non zero Nat st k <= s holds
   it.k = (k |^ (sequenceAk1Pk(s).k)) *
           Product((idseq(s) to_power sequenceAnPk(s,k)));
end;

registration
  let s be Nat;
  cluster sequenceQk(s) -> s-element;
end;

theorem :: NUMBER15:49
  for k, w being non zero Nat st k <= s & w <= s & w <> k holds
  (idseq(s) to_power sequenceA(s)).w =
  ((idseq(s) to_power sequenceAnPk(s,k)) |^ primenumber(k-1)).w;

theorem :: NUMBER15:50
  for k being non zero Nat st k <= s holds
  Problem58Solution(s).k = sequenceQk(s).k |^ primenumber(k-1);

registration
  cluster fAP-like increasing positive-yielding for FinSequence of NAT;
end;

registration
  let s be Nat;
  cluster Problem58Solution(s) -> fAP-like;
end;

theorem :: NUMBER15:51 :: Problem 58
  for s being Nat
   ex f being fAP-like increasing positive-yielding FinSequence of NAT
  st len f = s & for i being Nat st 1 <= i <= len f holds f.i is perfect_power;

begin :: Problem 160

theorem :: NUMBER15:52 :: Problem 160
  for x,y,z,t being positive Nat st x <= y <= z <= t holds
  1/x + 1/y + 1/z + 1/t = 1 iff
  x = 2 & y = 3 & z = 7 & t = 42 or
  x = 2 & y = 3 & z = 8 & t = 24 or
  x = 2 & y = 3 & z = 9 & t = 18 or
  x = 2 & y = 3 & z = 10 & t = 15 or
  x = 2 & y = 3 & z = 12 & t = 12 or
  x = 2 & y = 4 & z = 5 & t = 20 or
  x = 2 & y = 4 & z = 6 & t = 12 or
  x = 2 & y = 4 & z = 8 & t = 8 or
  x = 2 & y = 5 & z = 5 & t = 10 or
  x = 2 & y = 6 & z = 6 & t = 6 or
  x = 3 & y = 3 & z = 4 & t = 12 or
  x = 3 & y = 3 & z = 6 & t = 6 or
  x = 3 & y = 4 & z = 4 & t = 6 or
  x = 4 & y = 4 & z = 4 & t = 4;

begin

theorem :: NUMBER15:53 :: Problem 164
  for x,y,z,t being positive Integer holds
  1/(x^2) + 1/(y^2) + 1/(z^2) + 1/(t^2) = 1 iff x = 2 & y = 2 & z = 2 & t = 2;

begin :: Problem 168

reserve f,g for complex-valued FinSequence;

theorem :: NUMBER15:54
  len(f^2) = len f;

theorem :: NUMBER15:55
  len(f") = len f;

theorem :: NUMBER15:56
  (c(#)f)|n = c(#)(f|n);

theorem :: NUMBER15:57
  for f being complex-valued Function holds f" ^2 = f^2 ";

theorem :: NUMBER15:58
  for f being complex-valued Function holds (c(#)f)" = c" (#) f";

theorem :: NUMBER15:59
  (f^g)^2 = (f^2) ^ (g^2);

theorem :: NUMBER15:60
  (f^g)" = (f") ^ (g");

theorem :: NUMBER15:61
  (f|n)" = f"|n;

theorem :: NUMBER15:62
  (f|n)^2 = f^2|n;

theorem :: NUMBER15:63
  <*c*>" = <*c"*>;

theorem :: NUMBER15:64
  <*c1,c2*>" = <*c1",c2"*>;

theorem :: NUMBER15:65
  <*c1,c2,c3*>" = <*c1",c2",c3"*>;

definition
  let s be Nat;
  let f be (s+1)-element complex-valued FinSequence;
  attr f is a_solution_of_Sierp168 means
:: NUMBER15:def 12
  Sum ((f|s)" ^2) = 1 / (f.(s+1))^2;
end;

registration
  let a be object;
  cluster <*a*> -> (0+1)-element;
end;

registration
  let a,b be object;
  cluster <*a,b*> -> (1+1)-element;
end;

registration
  let a,b,c be object;
  cluster <*a,b,c*> -> (2+1)-element;
end;

theorem :: NUMBER15:66
  <*0*> is a_solution_of_Sierp168;

theorem :: NUMBER15:67
  <*1,1*> is a_solution_of_Sierp168;

theorem :: NUMBER15:68
  <*15,20,12*> is a_solution_of_Sierp168;

theorem :: NUMBER15:69
  for s,n being Nat
  for f being (s+1)-element complex-valued FinSequence holds
  f is a_solution_of_Sierp168 implies n(#)f is a_solution_of_Sierp168;

definition
  let s be positive Nat;
  let f be (s+1)-element complex-valued FinSequence;
  func SierpProblem168FS(f) -> FinSequence equals
:: NUMBER15:def 13
  12(#)f|(s-1) ^ <* 15*f.s, 20*f.s, 12*f.(s+1) *>;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element complex-valued FinSequence;
  cluster SierpProblem168FS(f) -> (s+1+1)-element;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element complex-valued FinSequence;
  cluster SierpProblem168FS(f) -> complex-valued;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element real-valued FinSequence;
  cluster SierpProblem168FS(f) -> real-valued;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element integer-valued FinSequence;
  cluster SierpProblem168FS(f) -> integer-valued;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element natural-valued FinSequence;
  cluster SierpProblem168FS(f) -> natural-valued;
end;

registration
  let c be non zero Complex;
  cluster <*c*> -> non-empty;
  let f be non-empty complex-valued FinSequence;
  cluster c(#)f -> non-empty;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element non-empty real-valued FinSequence;
  cluster SierpProblem168FS(f) -> non-empty;
end;

theorem :: NUMBER15:70
  for s being positive Nat
  ex f being (s+1)-element non-empty natural-valued FinSequence st
  f is a_solution_of_Sierp168;

definition
  let s be positive Nat;
  mode Solution_of_Sierp168 of s ->
       (s+1)-element positive-yielding natural-valued FinSequence means
:: NUMBER15:def 14
  it is a_solution_of_Sierp168;
end;

registration
  let s be positive Nat;
  cluster -> a_solution_of_Sierp168 for Solution_of_Sierp168 of s;
end;

registration
  let s,n be positive Nat;
  let f be Solution_of_Sierp168 of s;
  cluster n(#)f -> a_solution_of_Sierp168;
end;

theorem :: NUMBER15:71
  for s,n being positive Nat
  for f being Solution_of_Sierp168 of s holds
    n(#)f is Solution_of_Sierp168 of s;

definition
  let s be positive Nat;
  let f be (s+1)-element positive-yielding natural-valued FinSequence;
  func Solutions_of_Sierp168(f) -> ManySortedSet of NATPLUS means
:: NUMBER15:def 15
  for n being non zero Nat holds it.n = n(#)f;
end;

registration
  let s be positive Nat;
  let f be (s+1)-element positive-yielding natural-valued FinSequence;
  cluster Solutions_of_Sierp168(f) -> one-to-one;
end;

theorem :: NUMBER15:72
  for s being positive Nat
  for f being Solution_of_Sierp168 of s holds
  rng Solutions_of_Sierp168(f) c=
  the set of all g where g is Solution_of_Sierp168 of s;

theorem :: NUMBER15:73 :: Problem 168
  for S being positive Nat holds
  the set of all f where f is Solution_of_Sierp168 of S is infinite;

begin :: Problem 171

theorem :: NUMBER15:74  :: Problem 171 a
  for n being positive Integer holds n <= 7 or n in {9,10,12,15} iff
  not ex x,y being positive Integer st 3*x+5*y = n;

theorem :: NUMBER15:75 :: Problem 171 b
  for m, n being positive Integer st n > 40*m
  for A being finite set st
  A = { [x,y] where x,y is positive Integer: 3*x + 5*y = n }
  holds card A > m;

begin

theorem :: NUMBER15:76
  m <> 0 implies i div (i gcd m) , m div (i gcd m) are_coprime;

theorem :: NUMBER15:77 :: Problem 188
  not ex x,y,z,t being positive Nat st x^2 + 2*y^2 = z^2 & 2*x^2 + y^2 = t^2;

begin :: Problem 195

theorem :: NUMBER15:78
  n is even implies n mod 4 = 0 or n mod 4 = 2;

theorem :: NUMBER15:79
  n is even implies n,0 are_congruent_mod 4 or n,2 are_congruent_mod 4;

theorem :: NUMBER15:80
  n is odd implies n mod 4 = 1 or n mod 4 = 3;

theorem :: NUMBER15:81
  n is odd implies n,1 are_congruent_mod 4 or n,3 are_congruent_mod 4;

theorem :: NUMBER15:82
  i is even implies i|^3 mod 8 = 0;

theorem :: NUMBER15:83 :: Problem 195
  for k being non zero Nat holds
  not ex x,y being positive Nat st x|^2 + 2|^(2*k) + 1 = y|^3;

begin :: Problem 196

theorem :: NUMBER15:84 :: Problem 196 a
  for x,y,z,t being positive Nat st x <= y & x <= z <= t holds
  x+y = z*t & z+t = x*y iff
  x = 1 & y = 5 & z = 2 & t = 3 or
  x = 2 & y = 2 & z = 2 & t = 2;

definition
  func exampleSierpinski196 -> Function of NAT, [:INT,INT,INT,INT:] means
:: NUMBER15:def 16

  for n being Nat holds it.n = [-1,n,1-n,-1];
end;

registration
  cluster exampleSierpinski196 -> one-to-one;
end;

theorem :: NUMBER15:85
  rng exampleSierpinski196 c=
  { [x,y,z,t] where x,y,z,t is Integer: x+y = z*t & z+t = x*y };

theorem :: NUMBER15:86 :: Problem 196 b
  { [x,y,z,t] where x,y,z,t is Integer: x+y = z*t & z+t = x*y } is infinite;

begin :: Problem 198

reserve a,b,x,y for Real;

registration
  let r be non negative Real;
  cluster [/ r \] -> natural;
end;

registration
  let f be non empty positive-yielding real-valued FinSequence;
  cluster Sum f -> positive;
end;

registration
  let a,b be positive Real;
  let n be Nat;
  cluster (a,b) Subnomial n -> positive-yielding;
end;

registration
  let r be non positive Real;
  cluster <*r*> -> non positive-yielding;
end;

theorem :: NUMBER15:87  :: Problem 198 a
  for n,x,y being positive Nat holds
  a > 0 & 2 <= n & x|^n - y|^n = a implies
  x < (n-1) -Root a & y < (n-1) -Root a;

theorem :: NUMBER15:88 :: Problem 198 b
  for k,x,y being positive Nat holds
  a > 0 & x|^(2*k) - y|^(2*k) = a implies
  x < k-Root a & y < k-Root a;

theorem :: NUMBER15:89 :: Problem 198 c
  for a,x,y being Complex holds x|^1 - y|^1 = a iff x = a+y;

scheme :: NUMBER15:sch 1
  FinitePairs { M,N() -> Nat, P[object,object] } :
  { [m,n] where m,n is Nat: m < M() & n < N() & P[m,n] } is finite;

:: Method - finite number of checking
theorem :: NUMBER15:90 :: Problem 198 d
  for a,n being positive Nat st 2 <= n holds
  { [x,y] where x,y is positive Nat: x|^n - y|^n = a } is finite;
