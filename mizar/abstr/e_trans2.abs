      GROUP_1, POLYNOM5, FINSEQ_3, POLYFORM, FIB_NUM, LTLAXIO1, FIELD_1,
      ORDINAL2, MSAFREE2, SIN_COS, QC_LANG1, POWER, ALGNUM_1, POLYNOM2,
      RFINSEQ, FINSEQ_2, ABIAN, SEQ_2, COMPLEX1, C0SP1, SERIES_1, ROUGHIF2,
      FIN_TOPO, FINSET_1, ALGSEQ_1, MEMBERED, FUNCT_3, GAUSSINT, YELLOW_8,
      WAYBEL_8, COMPLFLD, GROUP_4, RAT_1, E_TRANS1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, RELSET_1,
      PARTFUN1, FUNCOP_1, FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      NAT_1, INT_1, MEMBERED, COMPLEX1, INT_2, NAT_D, XXREAL_2, FINSEQ_1,
      RAT_1, FINSEQ_2, VALUED_1, SEQ_2, NEWTON, RFINSEQ, ABIAN, POWER,
      SERIES_1, SIN_COS, WSIERP_1, STRUCT_0, GROUP_1, VECTSP_1, VECTSP_2,
      GROUP_4, POLYNOM1, ALGSEQ_1, COMPLFLD, VFUNCT_1, GCD_1, BINOM, POLYNOM3,
      POLYNOM4, RLVECT_1, POLYNOM5, INT_3, HURWITZ, IDEAL_1, C0SP1, VECTSP11,
      RATFUNC1, GAUSSINT, RING_1, RING_2, RING_4, ALGNUM_1, POLYDIFF, FIELD_1,
      RINGDER1, BASEL_2, E_TRANS1;
 constructors RELSET_1, REALSET1, NAT_D, BINOP_2, XXREAL_2, FINSOP_1, COMSEQ_2,
