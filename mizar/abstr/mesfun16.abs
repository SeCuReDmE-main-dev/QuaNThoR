      XXREAL_1, SEQ_1, MEASURE8, XREAL_0, FUNCT_7, XXREAL_2, MEMBERED, SEQ_4,
      STRUCT_0, PRE_TOPC, NORMSP_1, NFCONT_2, SQUARE_1, FCONT_1, REALSET1,
      DUALSP02, RCOMP_1, CFCONT_1, RAT_1, METRIC_1, FCONT_2;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1, SETFAM_1,
