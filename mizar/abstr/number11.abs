      VALUED_0, VALUED_1, POWER, WSIERP_1, AFINSQ_1, AFINSQ_2, FOMODEL0,
      NEWTON02, NEWTON04;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;


begin :: Preliminaries

registration
  let n be Nat;
  cluster <%n%> -> NAT-valued;
end;

registration
  let n1,n2 be Nat;
  cluster <%n1,n2%> -> NAT-valued;
end;

registration
  let n1,n2,n3 be Nat;
  cluster <%n1,n2,n3%> -> NAT-valued;
end;

registration
  let n1,n2,n3,n4 be Nat;
  cluster <%n1,n2,n3,n4%> -> NAT-valued;
end;

theorem :: NUMBER11:1
for b being Nat
for E being XFinSequence of NAT st E={} holds value(E,b)=0;

theorem :: NUMBER11:2
for n,b being Nat holds value(<%n%>,b)=n;

theorem :: NUMBER11:3
for n,b being Nat st n < b & b > 1 holds digits(n,b)=<%n%>;

theorem :: NUMBER11:4
for b being Nat st b > 1 holds digits(value(<%0%>,b),b)=<%0%>;

theorem :: NUMBER11:5
for b being Nat st b > 1
for s being NAT-valued XFinSequence st len s > 0 & s.((len s)-1) <> 0 &
for i being Nat st i in dom s holds s.i<b holds digits(value(s,b),b) = s;

theorem :: NUMBER11:6
for n,b being Nat st n < b & b > 1 holds Sum digits(n,b)=n;

theorem :: NUMBER11:7
for n,b being Nat st b > 1 holds value(n-->(b-'1),b) = b|^n - 1;

theorem :: NUMBER11:8
for b being Nat st b > 1
for s being NAT-valued XFinSequence st
len s > 0 & for i being Nat st i in dom s holds s.i<b
holds (s.((len s)-1))*(b|^((len s)-'1)) <= value(s,b) < b|^(len s);

theorem :: NUMBER11:9
for n,b being Nat st b > 1 holds n < b|^(len digits(n,b));

theorem :: NUMBER11:10
for n,m,b being Nat st n<>0 & b > 1 & m < len digits(n,b) holds n >= b|^m;

theorem :: NUMBER11:11
  for d1,d2 being XFinSequence of NAT, b being Nat st
  b>1 & dom d1=dom d2 & for n being Nat st n in dom d1 holds d1.n<=d2.n
  holds value(d1,b)<=value(d2,b);

theorem :: NUMBER11:12
for m,n,b being Nat st b>1 holds m<n iff (len digits(m,b) < len digits(n,b)
or len digits(m,b) = len digits(n,b) & ex i being Nat st
i < len digits(m,b) & digits(m,b).i < digits(n,b).i &
for j being Nat st j<len digits(m,b) & digits(m,b).j<>digits(n,b).j holds i>=j)
;

theorem :: NUMBER11:13
for n being Nat holds 100 divides n iff digits(n,10).0=0 & digits(n,10).1=0;

theorem :: NUMBER11:14
  for f being XFinSequence st len f >= 2 holds f|2 = <%f.0,f.1%>;

begin :: Problem 36

definition
  let n,s be Nat;
  pred Sierp36 n,s means
:: NUMBER11:def 1
  Sum digits(n,10) = s & s divides n &
  for m being Nat st Sum digits(m,10) = s & s divides m holds n <= m;
end;

theorem :: NUMBER11:15
for n being Nat st n < 10 holds Sierp36 n,n;

