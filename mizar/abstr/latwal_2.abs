environ

 vocabularies EQREL_1, LATTICES, STRUCT_0, PBOOLE, CARD_1, FUNCT_1, XXREAL_0,
      ZFMISC_1, FILTER_0, SGRAPH1, GRAPH_1, FILTER_1, SHEFFER1, XBOOLE_0,
      SUBSET_1, ROBBINS1, BINOP_1, LATTICE3, ORDERS_2, RELAT_2, PCS_0, JORDAN6,
      RELAT_1, PARTFUN1, TARSKI, LATTAD_1, LATWAL_1, ROBBINS3, LATWAL_2,
      ORDINAL1, GLIB_002;
 notations TARSKI, ENUMSET1, ZFMISC_1, XXREAL_0, SUBSET_1, ORDINAL1, XBOOLE_0,
      RELAT_1, RELAT_2, RELSET_1, EQREL_1, PARTFUN1, STRUCT_0, LATTICES,
      BINOP_1, ORDERS_2, ROBBINS1, SHEFFER1, LATTICE3, PCS_0, LATTAD_1,
      ROBBINS3, LATWAL_1;
 constructors BINOP_1, RELSET_1, SHEFFER1, LATTICE3, PCS_0, LATTAD_1, ROBBINS3,
      LATWAL_1, XXREAL_0;
 registrations RELSET_1, STRUCT_0, LATTICES, XXREAL_0, ORDINAL1, LATTAD_1,
      ORDERS_2, LATTICE3, ZFMISC_1, RELAT_2, LATWAL_1, ROBBINS3, PCS_0;
 requirements SUBSET, NUMERALS, BOOLE, REAL;


begin :: Preliminaries

:: reflexive antisymmetric = pseudo-order

registration
  cluster reflexive antisymmetric with_suprema with_infima for
    non empty RelStr;
end;

definition
  mode RT-Lattice is antisymmetric with_suprema with_infima
    non empty RelStr;
end;

definition
  mode WA-Lattice is reflexive antisymmetric with_suprema with_infima
    non empty RelStr;
end;

 reserve W for WA-Lattice;
 reserve a,b,c for Element of W;

theorem :: LATWAL_2:1
  a <= b iff a "\/" b = b;

theorem :: LATWAL_2:2
  a <= b iff a "/\" b = a;

theorem :: LATWAL_2:3
  a "/\" a = a;

theorem :: LATWAL_2:4
  a "\/" a = a;

theorem :: LATWAL_2:5
  a "/\" b = b "/\" a;

theorem :: LATWAL_2:6
  a "\/" b = b "\/" a;

theorem :: LATWAL_2:7
  (a "/\" b) "\/" a = a;

theorem :: LATWAL_2:8
  (a "\/" b) "/\" a = a;

theorem :: LATWAL_2:9
  W is transitive implies
    (a "\/" b) "\/" c = a "\/" (b "\/" c);

theorem :: LATWAL_2:10
  W is transitive implies
    (a "/\" b) "/\" c = a "/\" (b "/\" c);

theorem :: LATWAL_2:11
  a <= c & b <= c implies a "\/" b <= c;

theorem :: LATWAL_2:12
  a <= a "\/" b;

theorem :: LATWAL_2:13
  c <= a & c <= b implies c <= a "/\" b;

theorem :: LATWAL_2:14 :: 4.
  ((a "/\" c) "\/" (b "/\" c)) "\/" c = c;

theorem :: LATWAL_2:15 :: 4.  :: in LATWAL_1 appears [= instead of <=
  ((a "\/" c) "/\" (b "\/" c)) "/\" c = c;

begin :: Tolerance Structures

:: Definition 3

registration let D be trivial non empty set;
  cluster pcs-total D -> antisymmetric;
end;

registration
  cluster reflexive antisymmetric with_suprema with_infima
    non empty for pcs-Str;
end;

definition
  mode WAP-Lattice is reflexive antisymmetric with_suprema with_infima
    non empty pcs-Str;
end;

:: Compatibility in Tolerance Structures

definition
  let P be pcs-Str;
:: a (--) b means that a tolerates b
:: T is compatible with P
  attr P is pcs-Compatible means
:: LATWAL_2:def 1
  for a1,a2,b1,b2 being Element of P holds
  a1 (--) b1 & a2 (--) b2
    implies
    (a1 "\/" a2) (--) (b1 "\/" b2) & (a1 "/\" a2) (--) (b1 "/\" b2);
end;

:: Theorem 1

registration
  cluster trivial total pcs-Compatible for WAP-Lattice;
end;

:: Definition 4: Segment

definition let W be WA-Lattice;
  let a,b be Element of W;
  func Segment (a,b) -> Subset of W equals
:: LATWAL_2:def 2
    { x where x is Element of W : a <= x <= b or b <= x <= a };
end;

:: Section 2, before Proposition 1
:: The definition of a symmetric hull

definition let W be non empty RelStr;
  func SymmetricHull W -> Relation of the carrier of W means
:: LATWAL_2:def 3
    for x,y being Element of W holds
      [x,y] in it iff x <= y or y <= x;
end;

registration let W be WA-Lattice;
  cluster SymmetricHull W -> total;
end;

registration let W be WA-Lattice;
  cluster SymmetricHull W -> reflexive symmetric;
end;

registration let L be WA-Lattice;
  cluster total reflexive symmetric for Relation of the carrier of L;
end;

theorem :: LATWAL_2:16
  for W being WA-Lattice holds
    SymmetricHull W is Tolerance of the carrier of W;

definition let S be non empty RelStr;
  attr S is tournament means
:: LATWAL_2:def 4
    for x, y being Element of S holds
      x <= y or y <= x;
end;

theorem :: LATWAL_2:17 :: Proposition 1
  for S being non empty RelStr holds
:::  st the InternalRel of S is antisymmetric holds
     S is tournament
      iff
    SymmetricHull S = nabla the carrier of S;

begin :: Compatibility Relation Revisited

theorem :: LATWAL_2:18
  for P be non empty pcs-Str st
    the ToleranceRel of P = nabla the carrier of P holds
      P is pcs-Compatible;

theorem :: LATWAL_2:19
  for P be non empty pcs-Str st
    the ToleranceRel of P = id the carrier of P holds
      P is pcs-Compatible;

registration
  cluster pcs-Compatible pcs-tol-reflexive pcs-tol-symmetric for WAP-Lattice;
end;

 reserve W for pcs-Compatible pcs-tol-reflexive pcs-tol-symmetric WAP-Lattice;
 reserve a,b for Element of W;

theorem :: LATWAL_2:20
  for x being Element of W holds
    x (--) x;

theorem :: LATWAL_2:21
  for x,y being Element of W st
    x (--) y holds y (--) x;   :: x T y -> y T x

theorem :: LATWAL_2:22
  for a, b being Element of W holds
    a (--) b & b (--) b implies (a "/\" b) (--) (b "/\" b);

theorem :: LATWAL_2:23
  for a, b being Element of W holds
    a (--) b & b (--) b implies (a "/\" b) (--) b;

theorem :: LATWAL_2:24
  for a, b being Element of W holds
    a (--) b & a (--) a implies (a "/\" b) (--) a;

theorem :: LATWAL_2:25
  for a, b being Element of W holds
    a (--) b & a (--) a implies (a "\/" b) (--) a;

theorem :: LATWAL_2:26 :: Theorem 1
  for W being pcs-Compatible pcs-tol-reflexive
          pcs-tol-symmetric WAP-Lattice
  for a,b being Element of W holds
    a (--) b
     implies  :: (--) tolerates
      for x,y being Element of W st
      x in Segment (a "/\" b, a "\/" b) &
      y in Segment (a "/\" b, a "\/" b) holds
         x (--) y;

begin :: WA-Lattices and Pseudo-Orders

 reserve L for WA_Lattice;

theorem :: LATWAL_2:27  ::: WA version of LATTAD_1:27
  for L being WA_Lattice,
      x, y being Element of L holds
    [x,y] in LatOrder L iff x [= y;

theorem :: LATWAL_2:28
  dom LatOrder L = the carrier of L &
    rng LatOrder L = the carrier of L &
    field LatOrder L = the carrier of L;

definition let L;
  redefine func LatOrder L -> Relation of the carrier of L;
end;

registration let W be non empty WA_Lattice;
  cluster LatOrder W -> (the carrier of W)-defined;
  cluster LatOrder W -> (the carrier of W)-valued;
end;

registration let L;
  cluster LatOrder L -> total for Relation of the carrier of L;
end;

registration let W be non empty WA_Lattice;
  cluster LatOrder W -> reflexive;
end;

registration let W be non empty WA_Lattice;
  cluster LatOrder W -> antisymmetric;
end;

::: theorem :: automatically understood
:::  ExNearLattice is
:::    join-idempotent meet-idempotent join-commutative meet-commutative;

begin

registration
  cluster ExNearLattice -> satisfying_W3 satisfying_W3';
end;

:::theorem :: automatically understood
:::  ExNearLattice is WA_Lattice;

begin :: WA-Lattices (as lattices) and WA_Lattices (as relational structures)

definition
  let L be WA_Lattice;
  func LatRelStr L -> strict RelStr equals
:: LATWAL_2:def 5
:: LATTAD_1:def 12 is the version for generalized almost distributive
  RelStr (# the carrier of L, LatOrder L #);
end;

theorem :: LATWAL_2:29
  for L being WA_Lattice
  for x,y being Element of L,
      xx,yy being Element of LatRelStr L st
    x = xx & y = yy holds
  x [= y iff xx <= yy;

definition
  let L be WA_Lattice, p be Element of L;
  func p% -> Element of LatRelStr L equals
:: LATWAL_2:def 6
  p;
end;

definition
  let L be WA_Lattice, p be Element of LatRelStr L;
  func %p -> Element of L equals
:: LATWAL_2:def 7
  p;
end;

registration let L be WA_Lattice;
  cluster LatRelStr L -> reflexive antisymmetric;
end;

registration let L be WA_Lattice;
  cluster LatRelStr L -> with_suprema with_infima;
end;

registration
  cluster strict for WA_Lattice;
end;

begin

theorem :: LATWAL_2:30
  for L1,L2 being WA_Lattice st LatRelStr L1 = LatRelStr L2 holds
    the LattStr of L1 = the LattStr of L2;

theorem :: LATWAL_2:31
  for A being with_suprema with_infima WA-Lattice
   ex L being strict WA_Lattice st the RelStr of A = LatRelStr L;

theorem :: LATWAL_2:32 :: automatically understood
  LatRelStr ExNearLattice is WA-Lattice;

definition :: LATTICE3:def 15
  let A be RelStr such that
 A is with_suprema with_infima reflexive antisymmetric;
  func wlatt A -> strict WA_Lattice means
:: LATWAL_2:def 8
  the RelStr of A = LatRelStr it;
end;

theorem :: LATWAL_2:33
  wlatt LatRelStr ExNearLattice is WA_Lattice;

registration ::: move to LATWAL_1
  cluster -> satisfying_W3 for meet-associative join-absorbing Lattice;
end;

registration
  cluster -> join-idempotent meet-idempotent for Lattice;
end;

theorem :: LATWAL_2:34
  for L being Lattice holds
    LattRel L = LatOrder L;

theorem :: LATWAL_2:35
  for L being with_suprema with_infima Poset,
      a,b being Element of L,
      aa,bb being Element of latt L st
   a = aa & b = bb holds
    aa [= bb iff a <= b;

theorem :: LATWAL_2:36
  for L being WA-Lattice,
      a,b being Element of L,
      aa,bb being Element of wlatt L st a = aa & b = bb holds
    aa [= bb iff a <= b;

theorem :: LATWAL_2:37
  for L being WA-Lattice st
    the InternalRel of L is transitive holds
      wlatt L is Lattice;

begin :: Cycles and Tournaments

definition let L be WA-Lattice;
           let A be set;
  pred A is_cycle_of L means
:: LATWAL_2:def 9
  for a,b being Element of L st
    a <> b & a in A & b in A holds
      A = Segment (a,b);
end;

theorem :: LATWAL_2:38
  for L being WA-Lattice
  for a being Element of L holds
    {a} is_cycle_of L;

definition
  let L be WA-Lattice;
  let A be Subset of L;
  attr A is cyclic means
:: LATWAL_2:def 10
    A is_cycle_of L;
end;

registration let L be WA-Lattice;
  cluster cyclic for Subset of L;
end;

definition let L be WA-Lattice;
  mode Cycle of L is cyclic Subset of L;
end;

theorem :: LATWAL_2:39
  for L being WA-Lattice,
      a,b,x being Element of L st
    x in Segment (a,b) holds
      a <= x <= b or b <= x <= a;

definition let L be WA-Lattice;
  let A be Subset of L;
  attr A is tournament means
:: LATWAL_2:def 11
    for a,b being Element of L st a in A & b in A holds
      a <= b or b <= a;
end;

notation
  let L be WA-Lattice;
  let A be Subset of L;
  antonym A is acyclic for A is cyclic;
end;

begin :: Another Example of Weakly-Associative Lattice

::     function(^(_,_), [
::         0,0,0,0,0,
::         0,1,1,3,1,
::         0,1,2,2,2,
::         0,3,2,3,3,
::         0,1,2,3,4]),
::     function(v(_,_), [
::         0,1,2,3,4,
::         1,1,2,1,4,
::         2,2,2,3,4,
::         3,1,3,3,4,
::         4,4,4,4,4]),

registration
  cluster {0,1,2,3,4} -> non empty;
end;

registration
  cluster -> natural for Element of {0,1,2,3,4};
end;

definition
  let x,y be Element of {0,1,2,3,4};
  func x ex1234"\/" y -> Element of {0,1,2,3,4} equals
:: LATWAL_2:def 12
  1 if (x = 1 & y = 3) or (x = 3 & y = 1),
  max (x,y) if not ((x = 1 & y = 3) or (x = 3 & y = 1));
  func x ex1234"/\" y -> Element of {0,1,2,3,4} equals
:: LATWAL_2:def 13
  3 if (x = 1 & y = 3) or (x = 3 & y = 1),
  min (x,y) if not ((x = 1 & y = 3) or (x = 3 & y = 1));
end;

definition
  func ex1234\/ -> BinOp of {0,1,2,3,4} means
:: LATWAL_2:def 14
  for x,y being Element of {0,1,2,3,4} holds it.(x,y) = x ex1234"\/" y;
  func ex1234/\ -> BinOp of {0,1,2,3,4} means
:: LATWAL_2:def 15
  for x,y being Element of {0,1,2,3,4} holds it.(x,y) = x ex1234"/\" y;
end;

definition
  func ExWALattice -> non empty LattStr equals
:: LATWAL_2:def 16
    LattStr (#{0,1,2,3,4}, ex1234\/, ex1234/\ #);
end;

registration
  cluster ExWALattice -> non join-associative non meet-associative;
end;

registration
  cluster ExWALattice -> join-commutative meet-commutative
    ::: join-idempotent meet-idempotent
    join-absorbing meet-absorbing;
end;

registration
  cluster ExWALattice -> satisfying_W3 satisfying_W3';
end;
