environ

 vocabularies XBOOLE_0, FUNCT_1, XCMPLX_0, NUMBERS, RAT_1, INT_1, ZFMISC_1,
      ARYTM_1, RELAT_1, ARYTM_3, CARD_1, BINOP_2, NAT_1, REAL_1, RELSET_3,
      ORDINAL1, RELAT_2, TARSKI, MEMBERED, WELLORD1, FUNCT_5;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1, RELAT_2,
      MEMBERED, FUNCT_1, FUNCT_2, BINOP_1, SETWISEO, WELLORD1, ENUMSET1,
      ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, NUMBERS, RAT_1,
      VALUED_0, TOLER_1, BINOP_2, FUNCT_5;
 constructors BINOP_1, SETWISEO, XCMPLX_0, RAT_1, RELSET_1, VALUED_0, NUMBERS,
      RELAT_2, MEMBERED, BINOP_2, WELLORD1, FUNCT_5, CARD_1, TOLER_1;
 registrations ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, NAT_1, INT_1, RAT_1,
      RELSET_1, VALUED_0, MEMBERED, FUNCT_1, XBOOLE_0, CARD_1, RELAT_1;
 requirements BOOLE, SUBSET, ARITHM, NUMERALS, REAL;
 theorems TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELAT_2, XBOOLE_1, ENUMSET1,
      MEMBERED, ORDINAL1, CARD_1, CHORD, EXCHSORT, NAT_1, XREAL_1, RELSET_1,
      FUNCT_1, FUNCT_2, FUNCT_5, XCMPLX_0, XREAL_0, RAT_1, INT_1, MMLQUER2,
      BINOP_2, XCMPLX_1;
 schemes RELSET_1;

begin :: Preliminaries

:: not necessarily into MEMBERED - will cause unneeded expansions 
registration
  cluster -> natural-membered for Nat;
  coherence
  proof
    let n be Nat;
    now
      let x be object;
      assume A1: x in n;
      n in omega by ORDINAL1:def 12;
      then x in omega by A1, ORDINAL1:10;
      hence x is natural;
    end;
    hence thesis by MEMBERED:def 6;
  end;
end;

:: Succ Relation

 reserve X, Y for set, A for Ordinal;

definition
  let X;
  func succRel(X) -> Relation of X means
  :Def1:
  for x,y being set holds [x,y] in it iff x in X & y in X & y = succ x;
  existence
  proof
    defpred P[object,object] means $2 = succ Segm $1;
    consider R being Relation of X such that
      A1: for x,y being object holds [x,y] in R iff x in X & y in X & P[x,y]
      from RELSET_1:sch 1;
    take R;
    let x,y be set;
    hereby
      assume [x,y] in R;
      then x in X & y in X & P[x,y] by A1;
      hence x in X & y in X & y = succ x by ORDINAL1:def 17;
    end;
    assume x in X & y in X & y = succ x;
    then x in X & y in X & P[x,y] by ORDINAL1:def 17;
    hence [x,y] in R by A1;
  end;
  uniqueness
  proof
    let R1, R2 be Relation of X;
    assume that
      A2: for x,y being set holds [x,y] in R1 iff x in X & y in X & y = succ x
      and
      A3: for x,y being set holds [x,y] in R2 iff x in X & y in X & y = succ x;
    now
      let x,y be object;
      reconsider a=x,b=y as set by TARSKI:1;
      hereby
        assume [x,y] in R1;
        then [a,b] in R1;
        then a in X & b in X & b = succ a by A2;
        hence [x,y] in R2 by A3;
      end;
      assume [x,y] in R2;
      then [a,b] in R2;
      then a in X & b in X & b = succ a by A3;
      hence [x,y] in R1 by A2;
    end;
    hence R1 = R2 by RELAT_1:def 2;
  end;
end;

registration
  let X;
  cluster succRel(X) -> asymmetric;
  coherence
  proof
    now
      let x,y be object;
      reconsider a=x,b=y as set by TARSKI:1;
      assume x in field succRel(X) & y in field succRel(X) &
        [x,y] in succRel(X) & [y,x] in succRel(X);
      then b = succ a & a = succ b by Def1;
      then succ b in b by ORDINAL1:6;
      hence contradiction by ORDINAL1:6;
    end;
    hence thesis by RELAT_2:def 5, RELAT_2:def 13;
  end;
end;

registration
  cluster succRel {} -> empty;
  coherence;
  let X be trivial set;
  cluster succRel(X) -> empty;
  coherence
  proof
    assume succRel(X) is non empty;
    then consider z being object such that
      A1: z in succRel(X) by XBOOLE_0:def 1;
    consider x,y being object such that
      A2: z =[x,y] by A1, RELAT_1:def 1;
    reconsider a=x,b=y as set by TARSKI:1;
    [a,b] in succRel(X) by A1, A2;
    then A4: a in X & b in X & b = succ a by Def1;
    then a = b by ZFMISC_1:def 10;
    then b in b by A4, ORDINAL1:6;
    hence contradiction;
  end;
end;

theorem Th1:
  X c= Y implies succRel(X) c= succRel(Y)
proof
  assume A1: X c= Y;
  now
    let x,y be object;
    reconsider a=x,b=y as set by TARSKI:1;
    assume [x,y] in succRel(X);
    then [a,b] in succRel(X);
    then a in X & b in X & b = succ a by Def1;
    hence [x,y] in succRel(Y) by A1, Def1;
  end;
  hence thesis by RELAT_1:def 3;
end;

theorem
  succRel(X /\ Y) = succRel(X) /\ succRel(Y)
proof
  now
    let z be object;
    hereby
      assume A1: z in succRel(X /\ Y);
      then consider x,y being object such that
        A2: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(X /\ Y) by A1, A2;
      then a in X /\ Y & b in X /\ Y & b = succ a by Def1;
      then a in X & b in X & a in Y & b in Y & b = succ a by XBOOLE_0:def 4;
      hence z in succRel(X) & z in succRel(Y) by A2, Def1;
    end;
    assume A3: z in succRel(X) & z in succRel(Y);
    then consider x,y being object such that
      A4: z = [x,y] by RELAT_1:def 1;
    reconsider a=x,b=y as set by TARSKI:1;
    [a,b] in succRel(X) & [a,b] in succRel(Y) by A3, A4;
    then a in X & b in X & a in Y & b in Y & b = succ a by Def1;
    then a in X /\ Y & b in X /\ Y & b = succ a by XBOOLE_0:def 4;
    hence z in succRel(X /\ Y) by A4, Def1;
  end;
  hence thesis by XBOOLE_0:def 4;
end;

theorem
  succRel(X) \/ succRel(Y) c= succRel(X \/ Y)
proof
  X c= X \/ Y & Y c= X \/ Y by XBOOLE_1:7;
  then succRel(X) c= succRel(X \/ Y) &
    succRel(Y) c= succRel(X \/ Y) by Th1;
  hence thesis by XBOOLE_1:8;
end;

theorem Th4:
  for B,C being Ordinal holds [B,C] in succRel(A) iff succ B in A & C = succ B
proof
  let B, C be Ordinal;
  hereby
    assume [B,C] in succRel(A);
    then C in A & C = succ B by Def1;
    hence succ B in A & C = succ B;
  end;
  assume A1: succ B in A & C = succ B;
  B in succ B by ORDINAL1:6;
  then B in A by A1, ORDINAL1:10;
  hence thesis by A1, Def1;
end;

theorem Th5:
  for B being Ordinal st succ B in A holds [B, succ B] in succRel(A) by Th4;

theorem Th6:
  succRel(2) = {[0,1]}
proof
  now
    let z be object;
    hereby
      assume A1: z in succRel(2);
      then consider x,y being object such that
        A2: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(2) by A1, A2;
      then A3: a in 2 & b in 2 & b = succ a by Def1;
      then per cases by CARD_1:50, TARSKI:def 2;
      suppose a = 0;
        hence z = [0,1] by A2, A3;
      end;
      suppose a = 1;
        hence z = [0,1] by A3; :: by contradiction;
      end;
    end;
    assume A5: z = [0,1];
    1 = succ 0 & 1 in 2 by CARD_1:50, TARSKI:def 2;
    hence z in succRel(2) by A5, Th4;
  end;
  hence thesis by TARSKI:def 1;
end;

theorem Th7:
  succRel(3) = {[0,1], [1,2]}
proof
  now
    let z be object;
    thus z in succRel(3) implies z = [0,1] or z = [1,2]
    proof
      assume A1: z in succRel(3);
      then consider x,y being object such that
        A2: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(3) by A1, A2;
      then A3: a in 3 & b in 3 & b = succ a by Def1;
      then per cases by CARD_1:51, ENUMSET1:def 1;
      suppose a = 0;
        hence thesis by A2, A3;
      end;
      suppose a = 1;
        hence thesis by A2, A3;
      end;
      suppose a = 2;
        hence thesis by A3; :: by contradiction;
      end;
    end;
    assume A6: z = [0,1] or z = [1,2];
    1 = succ 0 & 1 in 3 & 2 = succ 1 & 2 in 3 by CARD_1:51, ENUMSET1:def 1;
    hence z in succRel(3) by A6, Th5;
  end;
  hence thesis by TARSKI:def 2;
end;

theorem Th8:
  succRel(4) = {[0,1], [1,2], [2,3]}
proof
  now
    let z be object;
    thus z in succRel(4) implies z = [0,1] or z = [1,2] or z = [2,3]
    proof
      assume A1: z in succRel(4);
      then consider x,y being object such that
        A2: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(4) by A1, A2;
      then A3: a in 4 & b in 4 & b = succ a by Def1;
      then per cases by CARD_1:52, ENUMSET1:def 2;
      suppose a = 0;
        hence thesis by A2, A3;
      end;
      suppose a = 1;
        hence thesis by A2, A3;
      end;
      suppose a = 2;
        hence thesis by A2, A3;
      end;
      suppose a = 3;
        hence thesis by A3; :: by contradiction;
      end;
    end;
    assume A7: z = [0,1] or z = [1,2] or z = [2,3];
    1 = succ 0 & 1 in 4 & 2 = succ 1 & 2 in 4 & 3 = succ 2 & 3 in 4
      by CARD_1:52, ENUMSET1:def 2;
    hence z in succRel(4) by A7, Th5;
  end;
  hence thesis by ENUMSET1:def 1;
end;

theorem Th9:
  succRel(5) = {[0,1], [1,2], [2,3], [3,4]}
proof
  now
    let z be object;
    thus z in succRel(5) implies z = [0,1] or z = [1,2] or z = [2,3]
      or z = [3,4]
    proof
      assume A1: z in succRel(5);
      then consider x,y being object such that
        A2: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(5) by A1, A2;
      then A3: a in 5 & b in 5 & b = succ a by Def1;
      then per cases by CARD_1:53, ENUMSET1:def 3;
      suppose a = 0;
        hence thesis by A2, A3;
      end;
      suppose a = 1;
        hence thesis by A2, A3;
      end;
      suppose a = 2;
        hence thesis by A2, A3;
      end;
      suppose a = 3;
        hence thesis by A2, A3;
      end;
      suppose a = 4;
        hence thesis by A3; :: by contradiction;
      end;
    end;
    assume A8: z = [0,1] or z = [1,2] or z = [2,3] or z = [3,4];
    1 = succ 0 & 1 in 5 & 2 = succ 1 & 2 in 5 & 3 = succ 2 & 3 in 5 &
      4 = succ 3 & 4 in 5 by CARD_1:53, ENUMSET1:def 3;
    hence z in succRel(5) by A8, Th4;
  end;
  hence thesis by ENUMSET1:def 2;
end;

theorem
  succRel(omega) = the set of all [n,n+1] where n is Nat
proof
  set S = the set of all [n,n+1] where n is Nat;
  now
    let z be object;
    hereby
      assume A0: z in succRel(omega);
      then consider x,y being object such that
        A0a: z = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in succRel(omega) by A0, A0a;
      then A1: a in omega & b in omega & b = succ a by Def1;
      then reconsider a,b as Nat;
      b = succ Segm a by A1, ORDINAL1:def 17
        .= Segm(a+1) by NAT_1:38
        .= a + 1 by ORDINAL1:def 17;
      hence z in S by A0a;
    end;
    assume z in S;
    then consider n being Nat such that
      A2: z = [n,n+1];
    A4: n+1 = Segm(n+1) by ORDINAL1:def 17
      .= succ Segm n by NAT_1:38
      .= succ n by ORDINAL1:def 17;
    n in omega & n+1 in omega by ORDINAL1:def 12;
    hence z in succRel(omega) by A2, A4, Def1;
  end;
  hence thesis by TARSKI:2;
end;

begin :: Add Relation

 reserve z,z1,z2 for Complex;
 reserve r,r1,r2 for Real;
 reserve q,q1,q2 for Rational;
 reserve i,i1,i2 for Integer;
 reserve n,n1,n2 for Nat;

registration
  let z;
  cluster (curry addcomplex).z -> Function-like Relation-like;
  coherence
  proof
    z in COMPLEX by XCMPLX_0:def 2;
    then [z,z] in [: COMPLEX, COMPLEX :] by ZFMISC_1:87;
    then [z,z] in dom addcomplex by FUNCT_2:def 1;
    then z in dom curry addcomplex by FUNCT_5:19;
    hence thesis by FUNCT_5:30;
  end;
end;

definition
  let X be complex-membered set;
  let z;
  func addRel(X,z) -> Relation of X equals
  ((curry addcomplex).z) |_2 X;
  correctness;
end;

registration
  let z;
  cluster addRel({},z) -> empty;
  coherence;
end;

theorem Th11:
  for X being complex-membered set
  holds [z1,z2] in addRel(X,z) iff z1 in X & z2 in X & z2 = z + z1
proof
  let X be complex-membered set;
  reconsider g = (curry addcomplex).z as Function;
  z in COMPLEX & z1 in COMPLEX by XCMPLX_0:def 2;
  then [z,z1] in [: COMPLEX, COMPLEX :] by ZFMISC_1:87;
  then A1: [z,z1] in dom addcomplex by FUNCT_2:def 1;
  hereby
    assume [z1,z2] in addRel(X,z);
    then [z1,z2] in g |_2 X & z1 is set & z2 is set by TARSKI:1;
    then A2: z1 in X & z2 in X & [z1,z2] in g by MMLQUER2:4;
    then z1 in dom g & g.z1 = z2 by FUNCT_1:1;
    then z2 = addcomplex.(z,z1) by A1, FUNCT_5:20;
    hence z1 in X & z2 in X & z2 = z + z1 by A2, BINOP_2:def 3;
  end;
  assume A3: z1 in X & z2 in X & z2 = z + z1;
  then A4: z2 = addcomplex.(z,z1) by BINOP_2:def 3
    .= g.z1 by A1, FUNCT_5:20;
  z1 in dom g by A1, FUNCT_5:20;
  hence thesis by A3, A4, FUNCT_1:1, MMLQUER2:4;
end;

theorem
  for X being complex-membered set holds addRel(X,0) = id X
proof
  let X be complex-membered set;
  now
    let x,y be object;
    hereby
      assume A1: [x,y] in addRel(X,0);
      reconsider z1=x,z2=y as set by TARSKI:1;
      [z1,z2] in addRel(X,0) by A1;
      then z1 in X & z2 in X by MMLQUER2:4;
      then reconsider z1,z2 as Complex;
      [z1,z2] in addRel(X,0) by A1;
      then z1 in X & z2 = 0 + z1 by Th11;
      hence x in X & x = y;
    end;
    assume A2: x in X & x = y;
    then reconsider z1=x,z2=y as Complex;
    z2 = 0 + z1 by A2;
    hence [x,y] in addRel(X,0) by A2, Th11;
  end;
  hence thesis by RELAT_1:def 10;
end;

registration
  let X be complex-membered set;
  let z be non zero Complex;
  cluster addRel(X,z) -> asymmetric;
  coherence
  proof
    now
      let x,y be object;
      reconsider a=x,b=y as set by TARSKI:1;
      assume A1: x in field addRel(X,z) & y in field addRel(X,z) &
        [x,y] in addRel(X,z) & [y,x] in addRel(X,z);
      then a in X & b in X by MMLQUER2:4;
      then reconsider a,b as Complex;
      b = z + a & a = z + b by A1, Th11;
      then 0 = 2*z;
      hence contradiction;
    end;
    hence thesis by RELAT_2:def 13, RELAT_2:def 5;
  end;
end;

theorem Th13:
  for X, Y being complex-membered set
  holds X c= Y implies addRel(X,z) c= addRel(Y,z)
proof
  let X, Y be complex-membered set;
  assume A1: X c= Y;
  now
    let x,y be object;
    reconsider a=x,b=y as set by TARSKI:1;
    assume A2: [x,y] in addRel(X,z);
    then [a,b] in addRel(X,z);
    then a in X & b in X by MMLQUER2:4;
    then reconsider a,b as Complex;
    [a,b] in addRel(X,z) by A2;
    then a in X & b in X & b = z + a by Th11;
    hence [x,y] in addRel(Y,z) by A1, Th11;
  end;
  hence thesis by RELAT_1:def 3;
end;

theorem
  for X, Y being complex-membered set holds
    addRel(X /\ Y,z) = addRel(X,z) /\ addRel(Y,z)
proof
  let X, Y be complex-membered set;
  now
    let z0 be object;
    hereby
      assume A1: z0 in addRel(X /\ Y,z);
      then consider x,y being object such that
        A2: z0 = [x,y] by RELAT_1:def 1;
      reconsider a=x,b=y as set by TARSKI:1;
      [a,b] in addRel(X /\ Y,z) by A1, A2;
      then a in X /\ Y & b in X /\ Y by MMLQUER2:4;
      then reconsider a,b as Complex;
      [a,b] in addRel(X /\ Y,z) by A1, A2;
      then a in X /\ Y & b in X /\ Y & b = z + a by Th11;
      then a in X & b in X & a in Y & b in Y & b = z + a by XBOOLE_0:def 4;
      hence z0 in addRel(X,z) & z0 in addRel(Y,z) by A2, Th11;
    end;
    assume A3: z0 in addRel(X,z) & z0 in addRel(Y,z);
    then consider x,y being object such that
      A4: z0 = [x,y] by RELAT_1:def 1;
    reconsider a=x,b=y as set by TARSKI:1;
    [a,b] in addRel(X,z) by A3, A4;
    then a in X & b in X by MMLQUER2:4;
    then reconsider a,b as Complex;
    [a,b] in addRel(X,z) & [a,b] in addRel(Y,z) by A3, A4;
    then a in X & b in X & a in Y & b in Y & b = z + a by Th11;
    then a in X /\ Y & b in X /\ Y & b = z + a by XBOOLE_0:def 4;
    hence z0 in addRel(X /\ Y,z) by A4, Th11;
  end;
  hence thesis by XBOOLE_0:def 4;
end;

theorem
  for X, Y being complex-membered set holds
    addRel(X,z) \/ addRel(Y,z) c= addRel(X \/ Y,z)
proof
  let X, Y be complex-membered set;
  X c= X \/ Y & Y c= X \/ Y by XBOOLE_1:7;
  then addRel(X,z) c= addRel(X \/ Y,z) & addRel(Y,z) c= addRel(X \/ Y,z)
    by Th13;
  hence thesis by XBOOLE_1:8;
end;

theorem
  for X being complex-membered set holds addRel(X,z)~ = addRel(X,-z)
proof
  let X be complex-membered set;
  now
    let x,y be object;
    reconsider a=x,b=y as set by TARSKI:1;
    hereby
      assume A1: [x,y] in addRel(X,-z);
      then [a,b] in addRel(X,-z);
      then a in X & b in X by MMLQUER2:4;
      then reconsider a,b as Complex;
      [a,b] in addRel(X,-z) by A1;
      then a in X & b in X & b = -z + a by Th11;
      then a in X & b in X & a = z + b;
      hence [y,x] in addRel(X,z) by Th11;
    end;
    assume A2: [y,x] in addRel(X,z);
    then [b,a] in addRel(X,z);
    then a in X & b in X by MMLQUER2:4;
    then reconsider a,b as Complex;
    [b,a] in addRel(X,z) by A2;
    then a in X & b in X & a = z + b by Th11;
    then a in X & b in X & b = -z + a;
    hence [x,y] in addRel(X,-z) by Th11;
  end;
  hence thesis by RELAT_1:def 7;
end;

theorem Th17:
  for X being complex-membered set holds
    addRel(X,z1) * addRel(X,z2) c= addRel(X,z1+z2)
proof
  let X be complex-membered set;
  now
    let x,y be object;
    assume [x,y] in addRel(X,z1) * addRel(X,z2);
    then consider z being object such that
      A1: [x,z] in addRel(X,z1) & [z,y] in addRel(X,z2) by RELAT_1:def 8;
    reconsider a = x, b = y, c = z as set by TARSKI:1;
    [a,c] in addRel(X,z1) & [c,b] in addRel(X,z2) by A1;
    then A2: a in X & c in X & b in X by MMLQUER2:4;
    then reconsider a,b,c as Complex;
    c = z1 + a & b = z2 + c by A1, Th11;
    then b = z1 + z2 + a;
    hence [x,y] in addRel(X,z1+z2) by A2, Th11;
  end;
  hence thesis by RELAT_1:def 3;
end;

theorem
  addRel(COMPLEX,z1) * addRel(COMPLEX,z2) = addRel(COMPLEX,z1+z2)
proof
  A1: addRel(COMPLEX,z1) * addRel(COMPLEX,z2) c= addRel(COMPLEX,z1+z2) by Th17;
  now
    let x,y be object;
    reconsider a=x,b=y as set by TARSKI:1;
    assume A2: [x,y] in addRel(COMPLEX,z1+z2);
    then [a,b] in addRel(COMPLEX,z1+z2);
    then A3: a in COMPLEX & b in COMPLEX by MMLQUER2:4;
    then reconsider a,b as Complex;
    A4: b = z1 + z2 + a by A2, Th11;
    set c = z1 + a;
    c in COMPLEX & b = z2 + c by A4, XCMPLX_0:def 2;
    then [a,c] in addRel(COMPLEX,z1) & [c,b] in addRel(COMPLEX,z2) by A3, Th11;
    hence [x,y] in addRel(COMPLEX,z1) * addRel(COMPLEX,z2) by RELAT_1:def 8;
  end;
  then addRel(COMPLEX,z1+z2) c= addRel(COMPLEX,z1) * addRel(COMPLEX,z2)
    by RELAT_1:def 3;
  hence thesis by A1, XBOOLE_0:def 10;
end;

theorem
