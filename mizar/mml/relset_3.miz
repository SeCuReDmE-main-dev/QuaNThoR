theorem
  addRel(COMPLEX,z) = the set of all [z1,z1+z] where z1
proof
  set S = the set of all [z1,z1+z] where z1;
  now
    let o be object;
    hereby
      assume A1: o in addRel(COMPLEX,z);
      then consider x,y being object such that
        A2: o = [x,y] by RELAT_1:def 1;
      reconsider x,y as set by TARSKI:1;
      [x,y] in addRel(COMPLEX,z) by A1, A2;
      then x in COMPLEX & y in COMPLEX by MMLQUER2:4;
      then reconsider x, y as Complex;
      y = z + x by A1, A2, Th11;
      hence o in S by A2;
    end;
    assume o in S;
    then consider z1 such that
      A3: o = [z1,z1+z];
    z1 in COMPLEX & z1+z in COMPLEX by XCMPLX_0:def 2;
    hence o in addRel(COMPLEX,z) by A3, Th11;
  end;
  hence thesis by TARSKI:2;
end;

registration
