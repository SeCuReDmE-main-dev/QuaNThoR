    then A5: a in X & b in X & [a,b] in g by MMLQUER2:4;
    then reconsider a,b as Integer;
    i in INT & a in INT by INT_1:def 2;
    then [i,a] in [: INT, INT :] by ZFMISC_1:87;
    then A6: [i,a] in dom addint by FUNCT_2:def 1;
