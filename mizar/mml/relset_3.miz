theorem
  addRel(NAT,n1) * addRel(NAT,n2) = addRel(NAT,n1+n2)
proof
  A1: addRel(NAT,n1) * addRel(NAT,n2) c= addRel(NAT,n1+n2) by Th17;
  now
    let x,y be object;
    reconsider a=x,b=y as set by TARSKI:1;
    assume A2: [x,y] in addRel(NAT,n1+n2);
    then [a,b] in addRel(NAT,n1+n2);
    then A3: a in NAT & b in NAT by MMLQUER2:4;
    then reconsider a,b as Nat;
    A4: b = n1 + n2 + a by A2, Th11;
    set c = n1 + a;
    c in NAT & b = n2 + c by A4, ORDINAL1:def 12;
    then [a,c] in addRel(NAT,n1) & [c,b] in addRel(NAT,n2) by A3, Th11;
    hence [x,y] in addRel(NAT,n1) * addRel(NAT,n2) by RELAT_1:def 8;
  end;
  then addRel(NAT,n1+n2) c= addRel(NAT,n1) * addRel(NAT,n2) by RELAT_1:def 3;
  hence thesis by A1, XBOOLE_0:def 10;
