ExW32:
  ExWALattice is satisfying_W3'
  proof
    set L = ExWALattice;
    for v2,v1,v0 being Element of L holds
      ((v0 "/\" v1) "\/" (v2 "/\" v1)) "\/" v1 = v1
    proof
      set W = {0,1,2,3,4};
      let v2,v1,v0 be Element of L;
      reconsider a = v0, b = v1, c = v2 as Element of W;
      per cases by ENUMSET1:def 3;
      suppose v1 = 4;
        hence thesis by HelpU4;
      end;

      suppose B1: v1 = 0; then
B2:     v0 "/\" v1 = 0 by HelpL0;
        v2 "/\" v1 = 0 by B1,HelpL0;
        hence thesis by B1,B2;
      end;

      suppose B1: v2 = 4 & v1 = 3 & v0 = 4; then
        v0 "/\" v1 = 3 by HelpL4;
        hence thesis by B1;
      end;
      suppose B1: v2 = 4 & v1 = 3 & v0 = 3; then
        v2 "/\" v1 = 3 by HelpL4;
        hence thesis by B1;
      end;
      suppose B1: v2 = 4 & v1 = 3 & v0 = 2; then
B2:     v0 "/\" v1 = 2 by HelpL23;
        v2 "/\" v1 = 3 by B1,HelpL4; then
        (v0 "/\" v1) "\/" (v2 "/\" v1) = 3 by B2,HelpU23;
        hence thesis by B1;
      end;
      suppose B1: v2 = 4 & v1 = 3 & v0 = 1; then
B2:     v0 "/\" v1 = 3 by HelpL13;
        v2 "/\" v1 = 3 by B1,HelpL4;
        hence thesis by B1,B2;
      end;
      suppose B1: v2 = 4 & v1 = 3 & v0 = 0; then
        v2 "/\" v1 = 3 by HelpL4; then
        (v0 "/\" v1) "\/" (v2 "/\" v1) = 3
          by B1,HelpU0,HelpL0;
        hence thesis by B1;
      end;

      suppose B1: v2 = 4 & v1 = 2 & v0 = 4; then
        v2 "/\" v1 = 2 by HelpL4;
        hence thesis by B1;
      end;
      suppose B1: v2 = 4 & v1 = 2 & v0 = 3; then
B2:     v0 "/\" v1 = 2 by HelpL23;
        v2 "/\" v1 = 2 by B1,HelpL4;
