      NUMBER09, RAMSEY_1, XBOOLE_0, ZFMISC_1, INT_4, NUMBER12, CARD_2,
      PRE_POLY, FINSEQ_2, PARTFUN1, SEQ_2, NUMBER13, FINSEQ_3, BINARI_6,
      UNIFORM1, NUMBER10, PRIMRECI, ABSVALUE, PBOOLE, FUNCOP_1, NAT_4, EULER_2,
