theorem Th1080:
Sum digits(175,10) = 13
proof
  thus Sum digits(175,10) = Sum <%5,7%>+Sum <%1%> by Th1079,AFINSQ_2:55
  .= (5 + 7) + Sum <%1%> by AFINSQ_2:54
  .= 12 + 1 by AFINSQ_2:53
  .= 13;
end;

theorem Th1081:
digits(225,10) = <%5,2,2%>
proof
  set d=<%5,2,2%>;
  set e=<%5*10|^0,2*10|^1,2*10|^2%>;
  A1: Sum e = Sum (<%5*10|^0,2*10|^1%>)+Sum(<%2*10|^2%>) by AFINSQ_2:55
  .= ((5*10|^0)+(2*10|^1))+Sum(<%2*10|^2%>) by AFINSQ_2:54
  .= ((5*10|^0)+(2*10|^1))+(2*10|^2) by AFINSQ_2:53
  .= 5*1 + 2*(10|^1) + 2*(10|^2) by NEWTON:4
  .= 5 + 2*10 + 2*(10|^2) by NEWTON:5
  .= 25 + 2*(10*10) by POLYEQ_5:1
  .= 225;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=225 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1082:
Sum digits(225,10) = 9
proof
  thus Sum digits(225,10) = Sum <%5,2%>+Sum <%2%> by Th1081,AFINSQ_2:55
  .= (5 + 2) + Sum <%2%> by AFINSQ_2:54
  .= 7 + 2 by AFINSQ_2:53
  .= 9;
end;

theorem Th1083:
digits(250,10) = <%0,5,2%>
proof
  set d=<%0,5,2%>;
  set e=<%0*10|^0,5*10|^1,2*10|^2%>;
  A1: Sum e = Sum (<%0*10|^0,5*10|^1%>)+Sum(<%2*10|^2%>) by AFINSQ_2:55
  .= ((0*10|^0)+(5*10|^1))+Sum(<%2*10|^2%>) by AFINSQ_2:54
  .= 0*1 + 5*(10|^1) + 2*(10|^2) by AFINSQ_2:53
  .= 0 + 5*10 + 2*(10|^2) by NEWTON:5
  .= 50 + 2*(10*10) by POLYEQ_5:1
  .= 250;
