  .= 2*1 + 3*(10|^1) + 4*(10|^2) by NEWTON:4
  .= 2 + 3*10 + 4*(10|^2) by NEWTON:5
  .= 32 + 4*(10*10) by POLYEQ_5:1
  .= 432;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
