  .= 5 + 3*10 + 1*(10|^2) by NEWTON:5
  .= 35 + 1*(10*10) by POLYEQ_5:1
  .= 135;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
