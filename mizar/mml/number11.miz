    then i in 4 by AFINSQ_1:84;
    then i in {0,1,2,3} by CARD_1:52;
    then i = 0 or i = 1 or i = 2 or i = 3 by ENUMSET1:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=2040 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 4-1 by AFINSQ_1:84;
  then A4: d.(len(d)-1) <> 0;
  now
