  end;
  suppose j=1;
    then Sum digits(m,10) = 3 by A2,Th93;
    hence contradiction by A1;
  end;
  suppose j=2;
    then Sum digits(m,10) = 6 by A2,Th95;
    hence contradiction by A1;
  end;
  suppose j=3;
