  then A3: value(d,10)=102 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
