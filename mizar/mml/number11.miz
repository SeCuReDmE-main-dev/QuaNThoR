proof
  thus Sum digits(252,10) = Sum <%2,5%>+Sum <%2%> by Th162,AFINSQ_2:55
  .= (2 + 5) + Sum <%2%> by AFINSQ_2:54
  .= 7 + 2 by AFINSQ_2:53
  .= 9;
end;

theorem Th164:
digits(266,10) = <%6,6,2%>
proof
  set d=<%6,6,2%>;
  set e=<%6*10|^0,6*10|^1,2*10|^2%>;
  A1: Sum e = Sum (<%6*10|^0,6*10|^1%>)+Sum(<%2*10|^2%>) by AFINSQ_2:55
  .= ((6*10|^0)+(6*10|^1))+Sum(<%2*10|^2%>) by AFINSQ_2:54
  .= ((6*10|^0)+(6*10|^1))+(2*10|^2) by AFINSQ_2:53
  .= 6*1 + 6*(10|^1) + 2*(10|^2) by NEWTON:4
  .= 6 + 6*10 + 2*(10|^2) by NEWTON:5
  .= 66 + 2*(10*10) by POLYEQ_5:1
  .= 266;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=266 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th165:
Sum digits(266,10) = 14
proof
  thus Sum digits(266,10) = Sum <%6,6%>+Sum <%2%> by Th164,AFINSQ_2:55
  .= (6 + 6) + Sum <%2%> by AFINSQ_2:54
  .= 12 + 2 by AFINSQ_2:53
  .= 14;
end;

theorem
Sierp36 266,14
proof
  thus Sum digits(266,10) = 14 by Th165;
  266=19*14;
  hence 14 divides 266 by INT_1:def 3;
  let m be Nat;
  assume A1: Sum digits(m,10) = 14 & 14 divides m;
  then consider j being Nat such that
  A2: m=14*j by NAT_D:def 3;
  assume m < 266;
  then 14*j < 14*19 by A2;
  then j < 18+1 by XREAL_1:64;
  then j <= 18 by NAT_1:9;
  then j=0 or ... or j=18;
  then per cases;
  suppose j=0;
    then Sum digits(m,10) = 0 by A2,Th6;
    hence contradiction by A1;
  end;
  suppose j=1;
    then Sum digits(m,10) = 5 by A2,Th137;
    hence contradiction by A1;
  end;
  suppose j=2;
    then Sum digits(m,10) = 10 by A2,Th139;
    hence contradiction by A1;
  end;
  suppose j=3;
    then Sum digits(m,10) = 6 by A2,Th141;
    hence contradiction by A1;
  end;
  suppose j=4;
    then Sum digits(m,10) = 11 by A2,Th143;
    hence contradiction by A1;
  end;
  suppose j=5;
    then Sum digits(m,10) = 7 by A2,Th29;
    hence contradiction by A1;
  end;
  suppose j=6;
    then Sum digits(m,10) = 12 by A2,Th145;
    hence contradiction by A1;
  end;
  suppose j=7;
    then Sum digits(m,10) = 17 by A2,Th147;
    hence contradiction by A1;
  end;
  suppose j=8;
    then Sum digits(m,10) = 4 by A2,Th149;
    hence contradiction by A1;
  end;
  suppose j=9;
    then Sum digits(m,10) = 9 by A2,Th151;
    hence contradiction by A1;
  end;
  suppose j=10;
    then Sum digits(m,10) = 5 by A2,Th43;
    hence contradiction by A1;
  end;
  suppose j=11;
    then Sum digits(m,10) = 10 by A2,Th80;
    hence contradiction by A1;
  end;
  suppose j=12;
    then Sum digits(m,10) = 15 by A2,Th153;
    hence contradiction by A1;
  end;
  suppose j=13;
    then Sum digits(m,10) = 11 by A2,Th124;
    hence contradiction by A1;
  end;
  suppose j=14;
    then Sum digits(m,10) = 16 by A2,Th155;
    hence contradiction by A1;
  end;
  suppose j=15;
    then Sum digits(m,10) = 3 by A2,Th157;
    hence contradiction by A1;
  end;
  suppose j=16;
    then Sum digits(m,10) = 8 by A2,Th159;
    hence contradiction by A1;
  end;
  suppose j=17;
    then Sum digits(m,10) = 13 by A2,Th161;
    hence contradiction by A1;
  end;
  suppose j=18;
    then Sum digits(m,10) = 9 by A2,Th163;
    hence contradiction by A1;
  end;
end;

theorem Th167:
digits(15,10) = <%5,1%>
proof
  set d=<%5,1%>;
  set e=<%5*10|^0,1*10|^1%>;
  A1: Sum e = (5*10|^0)+(1*10|^1) by AFINSQ_2:54
  .= 5*1+(1*10|^1) by NEWTON:4
  .= 5 + 1*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=15 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1  by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th168:
Sum digits(15,10) = 6
proof
  thus Sum digits(15,10) = Sum <%5%>+Sum <%1%> by Th167,AFINSQ_2:55
  .= 5 + Sum <%1%> by AFINSQ_2:53
  .= 5+1 by AFINSQ_2:53
  .= 6;
end;

