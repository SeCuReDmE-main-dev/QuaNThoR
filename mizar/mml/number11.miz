  A1: Sum e = Sum (<%5*10|^0,2*10|^1,8*10|^2%>)+Sum(<%1*10|^3%>) by AFINSQ_2:55
  .= Sum (<%5*10|^0,2*10|^1%>)+Sum(<%8*10|^2%>)+Sum(<%1*10|^3%>) by AFINSQ_2:55
  .= ((5*10|^0)+(2*10|^1))+Sum(<%8*10|^2%>)+Sum(<%1*10|^3%>) by AFINSQ_2:54
  .= ((5*10|^0)+(2*10|^1))+(8*10|^2)+Sum(<%1*10|^3%>) by AFINSQ_2:53
  .= ((5*10|^0)+(2*10|^1))+(8*10|^2)+(1*10|^3) by AFINSQ_2:53
  .= 5*1 + 2*(10|^1) + 8*(10|^2) + 1*(10|^3) by NEWTON:4
  .= 5 + 2*10 + 8*(10|^2) + 1*(10|^3) by NEWTON:5
  .= 25 + 8*(10*10) + 1*(10|^3) by POLYEQ_5:1
  .= 25 + 8*(10*10) + 1*(10*10*10) by POLYEQ_5:2
  .= 1825;
  A2: dom d = 4 by AFINSQ_1:84 .= dom e by AFINSQ_1:84;
  now
    let i be Nat;
    assume i in dom d;
    then i in 4 by AFINSQ_1:84;
    then i in {0,1,2,3} by CARD_1:52;
    then i = 0 or i = 1 or i = 2 or i = 3 by ENUMSET1:def 2;
    hence e.i=(d.i)*10|^i;
