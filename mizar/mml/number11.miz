  .= Sum (<%0*10|^0,4*10|^1%>)+Sum(<%0*10|^2%>)+Sum(<%2*10|^3%>) by AFINSQ_2:55
  .= ((0*10|^0)+(4*10|^1))+Sum(<%0*10|^2%>)+Sum(<%2*10|^3%>) by AFINSQ_2:54
  .= ((0*10|^0)+(4*10|^1))+(0*10|^2)+Sum(<%2*10|^3%>) by AFINSQ_2:53
  .= 0*1 + 4*(10|^1) + 0*(10|^2) + 2*(10|^3) by AFINSQ_2:53
  .= 0 + 4*10 + 0*(10|^2) + 2*(10|^3) by NEWTON:5
  .= 40 + 0*(10*10) + 2*(10*10*10) by POLYEQ_5:2
  .= 2040;
  A2: dom d = 4 by AFINSQ_1:84 .= dom e by AFINSQ_1:84;
  now
    let i be Nat;
