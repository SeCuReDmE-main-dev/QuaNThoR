  .= 78 + 1*(10*10) + 2*(10|^3) by POLYEQ_5:1
  .= 78 + 1*(10*10) + 2*(10*10*10) by POLYEQ_5:2
  .= 2178;
  A2: dom d = 4 by AFINSQ_1:84 .= dom e by AFINSQ_1:84;
  now
    let i be Nat;
