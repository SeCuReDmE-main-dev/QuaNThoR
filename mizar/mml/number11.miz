theorem Th1048:
digits(216,10) = <%6,1,2%>
proof
  set d=<%6,1,2%>;
  set e=<%6*10|^0,1*10|^1,2*10|^2%>;
  A1: Sum e = Sum (<%6*10|^0,1*10|^1%>)+Sum(<%2*10|^2%>) by AFINSQ_2:55
  .= ((6*10|^0)+(1*10|^1))+Sum(<%2*10|^2%>) by AFINSQ_2:54
  .= ((6*10|^0)+(1*10|^1))+(2*10|^2) by AFINSQ_2:53
  .= 6*1 + 1*(10|^1) + 2*(10|^2) by NEWTON:4
  .= 6 + 1*10 + 2*(10|^2) by NEWTON:5
  .= 16 + 2*(10*10) by POLYEQ_5:1
  .= 216;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=216 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1049:
Sum digits(216,10) = 9
proof
  thus Sum digits(216,10) = Sum <%6,1%>+Sum <%2%> by Th1048,AFINSQ_2:55
  .= (6 + 1) + Sum <%2%> by AFINSQ_2:54
  .= 7 + 2 by AFINSQ_2:53
  .= 9;
end;

theorem Th1050:
digits(312,10) = <%2,1,3%>
proof
  set d=<%2,1,3%>;
  set e=<%2*10|^0,1*10|^1,3*10|^2%>;
  A1: Sum e = Sum (<%2*10|^0,1*10|^1%>)+Sum(<%3*10|^2%>) by AFINSQ_2:55
  .= ((2*10|^0)+(1*10|^1))+Sum(<%3*10|^2%>) by AFINSQ_2:54
  .= ((2*10|^0)+(1*10|^1))+(3*10|^2) by AFINSQ_2:53
  .= 2*1 + 1*(10|^1) + 3*(10|^2) by NEWTON:4
  .= 2 + 1*10 + 3*(10|^2) by NEWTON:5
  .= 12 + 3*(10*10) by POLYEQ_5:1
  .= 312;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=312 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1051:
Sum digits(312,10) = 6
proof
  thus Sum digits(312,10) = Sum <%2,1%>+Sum <%3%> by Th1050,AFINSQ_2:55
  .= (2 + 1) + Sum <%3%> by AFINSQ_2:54
  .= 3 + 3 by AFINSQ_2:53
  .= 6;
end;

theorem Th1052:
digits(504,10) = <%4,0,5%>
proof
  set d=<%4,0,5%>;
  set e=<%4*10|^0,0*10|^1,5*10|^2%>;
  A1: Sum e = Sum (<%4*10|^0,0*10|^1%>)+Sum(<%5*10|^2%>) by AFINSQ_2:55
  .= ((4*10|^0)+(0*10|^1))+Sum(<%5*10|^2%>) by AFINSQ_2:54
  .= ((4*10|^0)+(0*10|^1))+(5*10|^2) by AFINSQ_2:53
  .= 4*1 + 0*(10|^1) + 5*(10|^2) by NEWTON:4
  .= 4 + 5*(10*10) by POLYEQ_5:1
  .= 504;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=504 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1053:
Sum digits(504,10) = 9
proof
  thus Sum digits(504,10) = Sum <%4,0%>+Sum <%5%> by Th1052,AFINSQ_2:55
  .= (4 + 0) + Sum <%5%> by AFINSQ_2:54
  .= 4 + 5 by AFINSQ_2:53
  .= 9;
end;

