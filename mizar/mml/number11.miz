theorem
Sierp36 1679,23
proof
  thus Sum digits(1679,10) = 23 by Th1046;
  1679=73*23;
  hence 23 divides 1679 by INT_1:def 3;
  let m be Nat;
  assume A1: Sum digits(m,10) = 23 & 23 divides m;
  then consider j being Nat such that
  A2: m=23*j by NAT_D:def 3;
  assume m < 1679;
  then 23*j < 23*73 by A2;
  then j < 72+1 by XREAL_1:64;
  then j <= 72 by NAT_1:9;
  then j=0 or ... or j=72;
  then per cases;
  suppose j=0;
    then Sum digits(m,10) = 0 by A2,Th6;
    hence contradiction by A1;
  end;
  suppose j=1;
    then Sum digits(m,10) = 5 by A2,Th922;
    hence contradiction by A1;
  end;
  suppose j=2;
    then Sum digits(m,10) = 10 by A2,Th924;
    hence contradiction by A1;
  end;
  suppose j=3;
    then Sum digits(m,10) = 15 by A2,Th926;
    hence contradiction by A1;
  end;
  suppose j=4;
    then Sum digits(m,10) = 11 by A2,Th928;
    hence contradiction by A1;
  end;
  suppose j=5;
    then Sum digits(m,10) = 7 by A2,Th930;
    hence contradiction by A1;
  end;
  suppose j=6;
    then Sum digits(m,10) = 12 by A2,Th932;
    hence contradiction by A1;
  end;
  suppose j=7;
    then Sum digits(m,10) = 8 by A2,Th934;
    hence contradiction by A1;
  end;
  suppose j=8;
    then Sum digits(m,10) = 13 by A2,Th936;
    hence contradiction by A1;
  end;
  suppose j=9;
    then Sum digits(m,10) = 9 by A2,Th938;
    hence contradiction by A1;
  end;
  suppose j=10;
    then Sum digits(m,10) = 5 by A2,Th940;
    hence contradiction by A1;
  end;
  suppose j=11;
    then Sum digits(m,10) = 10 by A2,Th942;
    hence contradiction by A1;
  end;
  suppose j=12;
    then Sum digits(m,10) = 15 by A2,Th944;
    hence contradiction by A1;
  end;
