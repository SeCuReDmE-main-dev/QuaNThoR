theorem Th729:
digits(21,10) = <%1,2%>
proof
  set d=<%1,2%>;
  set e=<%1*10|^0,2*10|^1%>;
  A1: Sum e = 1*1+(2*10|^1) by AFINSQ_2:54
  .= 1 + 2*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=21 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th730:
Sum digits(21,10) = 3
proof
  thus Sum digits(21,10) = Sum <%1%>+Sum <%2%> by Th729,AFINSQ_2:55
  .= 1 + Sum <%2%> by AFINSQ_2:53
  .= 1+2 by AFINSQ_2:53
  .= 3;
end;

theorem Th731:
digits(63,10) = <%3,6%>
proof
  set d=<%3,6%>;
  set e=<%3*10|^0,6*10|^1%>;
  A1: Sum e = (3*10|^0)+(6*10|^1) by AFINSQ_2:54
  .= 3*1+(6*10|^1) by NEWTON:4
  .= 3 + 6*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=63 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th732:
Sum digits(63,10) = 9
proof
  thus Sum digits(63,10) = Sum <%3%>+Sum <%6%> by Th731,AFINSQ_2:55
  .= 3 + Sum <%6%> by AFINSQ_2:53
  .= 3+6 by AFINSQ_2:53
  .= 9;
end;

theorem Th733:
digits(147,10) = <%7,4,1%>
proof
  set d=<%7,4,1%>;
  set e=<%7*10|^0,4*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%7*10|^0,4*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((7*10|^0)+(4*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((7*10|^0)+(4*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 7*1 + 4*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 7 + 4*10 + 1*(10|^2) by NEWTON:5
  .= 47 + 1*(10*10) by POLYEQ_5:1
  .= 147;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=147 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th734:
Sum digits(147,10) = 12
proof
  thus Sum digits(147,10) = Sum <%7,4%>+Sum <%1%> by Th733,AFINSQ_2:55
  .= (7 + 4) + Sum <%1%> by AFINSQ_2:54
  .= 11 + 1 by AFINSQ_2:53
  .= 12;
end;

theorem Th735:
digits(189,10) = <%9,8,1%>
proof
  set d=<%9,8,1%>;
  set e=<%9*10|^0,8*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%9*10|^0,8*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((9*10|^0)+(8*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((9*10|^0)+(8*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 9*1 + 8*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 9 + 8*10 + 1*(10|^2) by NEWTON:5
  .= 89 + 1*(10*10) by POLYEQ_5:1
  .= 189;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=189 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
