theorem Th115:
digits(104,10) = <%4,0,1%>
proof
  set d=<%4,0,1%>;
  set e=<%4*10|^0,0*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%4*10|^0,0*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((4*10|^0)+(0*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((4*10|^0)+(0*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 4*1 + 0*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 4 + 1*(10*10) by POLYEQ_5:1
  .= 104;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
