theorem Th921:
digits(23,10) = <%3,2%>
proof
  set d=<%3,2%>;
  set e=<%3*10|^0,2*10|^1%>;
  A1: Sum e = (3*10|^0)+(2*10|^1) by AFINSQ_2:54
  .= 3*1+(2*10|^1) by NEWTON:4
  .= 3 + 2*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=23 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th922:
Sum digits(23,10) = 5
proof
  thus Sum digits(23,10) = Sum <%3%>+Sum <%2%> by Th921,AFINSQ_2:55
  .= 3 + Sum <%2%> by AFINSQ_2:53
  .= 3+2 by AFINSQ_2:53
  .= 5;
end;

theorem Th923:
digits(46,10) = <%6,4%>
proof
  set d=<%6,4%>;
  set e=<%6*10|^0,4*10|^1%>;
  A1: Sum e = (6*10|^0)+(4*10|^1) by AFINSQ_2:54
  .= 6*1+(4*10|^1) by NEWTON:4
  .= 6 + 4*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=46 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th924:
Sum digits(46,10) = 10
proof
  thus Sum digits(46,10) = Sum <%6%>+Sum <%4%> by Th923,AFINSQ_2:55
  .= 6 + Sum <%4%> by AFINSQ_2:53
  .= 6+4 by AFINSQ_2:53
  .= 10;
end;

theorem Th925:
digits(69,10) = <%9,6%>
proof
  set d=<%9,6%>;
  set e=<%9*10|^0,6*10|^1%>;
  A1: Sum e = (9*10|^0)+(6*10|^1) by AFINSQ_2:54
  .= 9*1+(6*10|^1) by NEWTON:4
  .= 9 + 6*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=69 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th926:
Sum digits(69,10) = 15
proof
  thus Sum digits(69,10) = Sum <%9%>+Sum <%6%> by Th925,AFINSQ_2:55
  .= 9 + Sum <%6%> by AFINSQ_2:53
  .= 9+6 by AFINSQ_2:53
  .= 15;
end;

theorem Th927:
digits(92,10) = <%2,9%>
proof
  set d=<%2,9%>;
  set e=<%2*10|^0,9*10|^1%>;
  A1: Sum e = (2*10|^0)+(9*10|^1) by AFINSQ_2:54
  .= 2*1+(9*10|^1) by NEWTON:4
  .= 2 + 9*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
