  then consider j being Nat such that
  A2: m=17*j by NAT_D:def 3;
  assume m < 476;
  then 17*j < 17*28 by A2;
  then j < 27+1 by XREAL_1:64;
  then j <= 27 by NAT_1:9;
  then j=0 or ... or j=27;
