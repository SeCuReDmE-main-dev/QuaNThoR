theorem Th233:
digits(119,10) = <%9,1,1%>
proof
  set d=<%9,1,1%>;
  set e=<%9*10|^0,1*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%9*10|^0,1*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((9*10|^0)+(1*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((9*10|^0)+(1*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 9*1 + 1*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 9 + 1*10 + 1*(10|^2) by NEWTON:5
  .= 19 + 1*(10*10) by POLYEQ_5:1
  .= 119;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
