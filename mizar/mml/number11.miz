theorem Th1075:
digits(25,10) = <%5,2%>
proof
  set d=<%5,2%>;
  set e=<%5*10|^0,2*10|^1%>;
  A1: Sum e = (5*10|^0)+(2*10|^1) by AFINSQ_2:54
  .= 5*1+(2*10|^1) by NEWTON:4
  .= 5 + 2*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=25 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 2 by AFINSQ_1:38;
    then i in {0,1} by CARD_1:50;
    then i = 0 or i = 1 by TARSKI:def 2;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1076:
Sum digits(25,10) = 7
proof
  thus Sum digits(25,10) = Sum <%5%>+Sum <%2%> by Th1075,AFINSQ_2:55
  .= 5 + Sum <%2%> by AFINSQ_2:53
  .= 5+2 by AFINSQ_2:53
  .= 7;
end;

theorem Th1077:
digits(125,10) = <%5,2,1%>
proof
  set d=<%5,2,1%>;
  set e=<%5*10|^0,2*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%5*10|^0,2*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((5*10|^0)+(2*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((5*10|^0)+(2*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 5*1 + 2*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 5 + 2*10 + 1*(10|^2) by NEWTON:5
  .= 25 + 1*(10*10) by POLYEQ_5:1
  .= 125;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=125 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 3-1 by AFINSQ_1:39;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
    hence 0 <= d.i & d.i < 10;
  end;
  hence thesis by A3,A4,NUMERAL1:def 2;
end;

theorem Th1078:
Sum digits(125,10) = 8
proof
  thus Sum digits(125,10) = Sum <%5,2%>+Sum <%1%> by Th1077,AFINSQ_2:55
  .= (5 + 2) + Sum <%1%> by AFINSQ_2:54
  .= 7 + 1 by AFINSQ_2:53
  .= 8;
end;

theorem Th1079:
digits(175,10) = <%5,7,1%>
proof
  set d=<%5,7,1%>;
  set e=<%5*10|^0,7*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%5*10|^0,7*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
