  .= 0 + 2*10 + 10|^2 by NEWTON:5
  .= 20 + 10*10 by POLYEQ_5:1
  .= 120;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
