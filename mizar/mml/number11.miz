theorem Th353:
digits(836,10) = <%6,3,8%>
proof
  set d=<%6,3,8%>;
  set e=<%6*10|^0,3*10|^1,8*10|^2%>;
  A1: Sum e = Sum (<%6*10|^0,3*10|^1%>)+Sum(<%8*10|^2%>) by AFINSQ_2:55
  .= ((6*10|^0)+(3*10|^1))+Sum(<%8*10|^2%>) by AFINSQ_2:54
  .= ((6*10|^0)+(3*10|^1))+(8*10|^2) by AFINSQ_2:53
  .= 6*1 + 3*(10|^1) + 8*(10|^2) by NEWTON:4
  .= 6 + 3*10 + 8*(10|^2) by NEWTON:5
  .= 36 + 8*(10*10) by POLYEQ_5:1
  .= 836;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
