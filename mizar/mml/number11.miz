theorem Th63:
digits(55,10) = <%5,5%>
proof
  set d=<%5,5%>;
  set e=<%5*10|^0,5*10|^1%>;
  A1: Sum e = (5*10|^0)+(5*10|^1) by AFINSQ_2:54
  .= 5*1+(5*10|^1) by NEWTON:4
  .= 5 + 5*10 by NEWTON:5;
  A2: dom d = 2 by AFINSQ_1:38 .= dom e by AFINSQ_1:38;
  now
    let i be Nat;
    assume i in dom d;
