  .= 7 + 4*10 + 2*(10|^2) by NEWTON:5
  .= 47 + 2*(10*10) by POLYEQ_5:1
  .= 247;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
