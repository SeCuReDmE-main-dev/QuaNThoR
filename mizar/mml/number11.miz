theorem Th214:
digits(416,10) = <%6,1,4%>
proof
  set d=<%6,1,4%>;
  set e=<%6*10|^0,1*10|^1,4*10|^2%>;
  A1: Sum e = Sum (<%6*10|^0,1*10|^1%>)+Sum(<%4*10|^2%>) by AFINSQ_2:55
  .= ((6*10|^0)+(1*10|^1))+Sum(<%4*10|^2%>) by AFINSQ_2:54
  .= ((6*10|^0)+(1*10|^1))+(4*10|^2) by AFINSQ_2:53
  .= 6*1 + 1*(10|^1) + 4*(10|^2) by NEWTON:4
  .= 6 + 1*10 + 4*(10|^2) by NEWTON:5
  .= 16 + 4*(10*10) by POLYEQ_5:1
  .= 416;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
