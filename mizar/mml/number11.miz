  .= 5 + 7*10 + 1*(10|^2) by NEWTON:5
  .= 75 + 1*(10*10) by POLYEQ_5:1
  .= 175;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
