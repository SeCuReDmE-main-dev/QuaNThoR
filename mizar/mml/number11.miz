  .= (0 + 0) + Sum <%1%> by AFINSQ_2:54
  .= 1 by AFINSQ_2:53;
end;

theorem Th36:
digits(110,10) = <%0,1,1%>
proof
  set d=<%0,1,1%>;
  set e=<%0*10|^0,1*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%0*10|^0,1*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((0*10|^0)+(1*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((0*10|^0)+(1*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 0 + 1*10 + 10|^2 by NEWTON:5
  .= 10 + 10*10 by POLYEQ_5:1
  .= 110;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
