  .= 12 + 3 by AFINSQ_2:53
  .= 15;
end;

theorem Th212:
digits(400,10) = <%0,0,4%>
proof
  set d=<%0,0,4%>;
  set e=<%0*10|^0,0*10|^1,4*10|^2%>;
  A1: Sum e = Sum (<%0*10|^0,0*10|^1%>)+Sum(<%4*10|^2%>) by AFINSQ_2:55
  .= ((0*10|^0)+(0*10|^1))+Sum(<%4*10|^2%>) by AFINSQ_2:54
  .= 0*1 + 0*(10|^1) + 4*(10|^2) by AFINSQ_2:53
  .= 0 + 4*(10*10) by POLYEQ_5:1
  .= 400;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
