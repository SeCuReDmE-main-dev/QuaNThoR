  end;
  then A3: value(d,10)=1495 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 4-1 by AFINSQ_1:84;
  then A4: d.(len(d)-1) <> 0;
  now
    let i be Nat;
