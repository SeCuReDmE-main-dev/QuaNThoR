theorem Th1376:
Sum digits(4975,10) = 25
proof
  thus Sum digits(4975,10) = Sum <%5,7,9%>+Sum <%4%> by Th1375,AFINSQ_2:55
  .= Sum <%5,7%> + Sum <%9%> + Sum <%4%> by AFINSQ_2:55
  .= (5 + 7) + Sum <%9%> + Sum <%4%> by AFINSQ_2:54
  .= (5 + 7 + 9) + Sum <%4%> by AFINSQ_2:53
  .= 21 + 4 by AFINSQ_2:53
  .= 25;
end;

theorem
Sierp36 4975,25
proof
  thus Sum digits(4975,10) = 25 by Th1376;
  4975=199*25;
  hence 25 divides 4975 by INT_1:def 3;
  let m be Nat;
  assume A1: Sum digits(m,10) = 25 & 25 divides m;
  then consider j being Nat such that
  A2: m=25*j by NAT_D:def 3;
  assume m < 4975;
  then 25*j < 25*199 by A2;
  then j < 198+1 by XREAL_1:64;
  then j <= 198 by NAT_1:9;
  then j <= 99 or (j >= 99+1 & j <= 198) by NAT_1:9;
  then (j=0 or ... or j=99) or (j=100 or ... or j=198);
  then per cases;
  suppose j=0;
    then Sum digits(m,10) = 0 by A2,Th6;
    hence contradiction by A1;
  end;
  suppose j=1;
    then Sum digits(m,10) = 7 by A2,Th1076;
    hence contradiction by A1;
