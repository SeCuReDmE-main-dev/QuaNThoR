  .= 5 + 9*10 + 4*(10|^2) + 1*(10|^3) by NEWTON:5
  .= 95 + 4*(10*10) + 1*(10|^3) by POLYEQ_5:1
  .= 95 + 4*(10*10) + 1*(10*10*10) by POLYEQ_5:2
  .= 1495;
  A2: dom d = 4 by AFINSQ_1:84 .= dom e by AFINSQ_1:84;
