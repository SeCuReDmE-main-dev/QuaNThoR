  .= (9 + 8) + Sum <%1%> by AFINSQ_2:54
  .= 17 + 1 by AFINSQ_2:53
  .= 18;
end;

theorem Th737:
digits(231,10) = <%1,3,2%>
proof
  set d=<%1,3,2%>;
  set e=<%1*10|^0,3*10|^1,2*10|^2%>;
  A1: Sum e = Sum (<%1*10|^0,3*10|^1%>)+Sum(<%2*10|^2%>) by AFINSQ_2:55
  .= ((1*10|^0)+(3*10|^1))+Sum(<%2*10|^2%>) by AFINSQ_2:54
  .= 1*1 + 3*(10|^1) + 2*(10|^2) by AFINSQ_2:53
  .= 1 + 3*10 + 2*(10|^2) by NEWTON:5
  .= 31 + 2*(10*10) by POLYEQ_5:1
  .= 231;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
