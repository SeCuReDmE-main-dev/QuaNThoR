theorem
Sierp36 48,12
proof
  thus Sum digits(48,10) = 12 by Th99;
  48=4*12;
  hence 12 divides 48 by INT_1:def 3;
  let m be Nat;
  assume A1: Sum digits(m,10) = 12 & 12 divides m;
  then consider j being Nat such that
  A2: m=12*j by NAT_D:def 3;
