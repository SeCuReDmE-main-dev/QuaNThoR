  then 12*j < 12*4 by A2;
  then j < 3+1 by XREAL_1:64;
  then j <= 3 by NAT_1:9;
  then j=0 or ... or j=3;
  then per cases;
  suppose j=0;
    then Sum digits(m,10) = 0 by A2,Th6;
