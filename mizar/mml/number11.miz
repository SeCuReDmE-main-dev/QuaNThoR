theorem Th231:
digits(102,10) = <%2,0,1%>
proof
  set d=<%2,0,1%>;
  set e=<%2*10|^0,0*10|^1,1*10|^2%>;
  A1: Sum e = Sum (<%2*10|^0,0*10|^1%>)+Sum(<%1*10|^2%>) by AFINSQ_2:55
  .= ((2*10|^0)+(0*10|^1))+Sum(<%1*10|^2%>) by AFINSQ_2:54
  .= ((2*10|^0)+(0*10|^1))+(1*10|^2) by AFINSQ_2:53
  .= 2*1 + 0*(10|^1) + 1*(10|^2) by NEWTON:4
  .= 2 + 1*(10*10) by POLYEQ_5:1
  .= 102;
  A2: dom d = 3 by AFINSQ_1:39 .= dom e by AFINSQ_1:39;
  now
    let i be Nat;
    assume i in dom d;
    then i in 3 by AFINSQ_1:39;
    then i in {0,1,2} by CARD_1:51;
    then i = 0 or i = 1 or i = 2 by ENUMSET1:def 1;
