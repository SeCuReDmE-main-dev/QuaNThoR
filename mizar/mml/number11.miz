    then i = 0 or i = 1 by TARSKI:def 2;
    hence e.i=(d.i)*10|^i;
  end;
  then A3: value(d,10)=22 by A1,A2,NUMERAL1:def 1;
  len(d) - 1 = 2-1 by AFINSQ_1:38;
  then A4: d.(len(d)-1) <> 0;
