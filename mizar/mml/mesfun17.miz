      FCONT_2, SUPINF_1, SUPINF_2, PROB_1, RCOMP_1, MEASURE5, MEASUR12,
      MESFUNC5, MESFUNC6, INTEGRA1, INTEGRA5, MEASUR10, MEASUR11, MESFUN12,
      SEQ_4, STRUCT_0, ALGSTR_0, PRE_TOPC, NORMSP_0, NORMSP_1, NFCONT_1,
      LOPBAN_5, PRVECT_3, PRVECT_4, NFCONT_2, DUALSP02;
 constructors EXTREAL1, SUPINF_1, MESFUNC2, MEASUR11, MESFUN12, MESFUNC6,
      DOMAIN_1, FCONT_1, FCONT_2, MEASUR12, INTEGRA1, COMSEQ_2, NEWTON,
      INTEGRA5, SEQ_4, BINOP_2, SQUARE_1, NFCONT_1, PRVECT_4, NFCONT_2,
      DUALSP02, LOPBAN_5, NDIFF_8, LPSPACE1, MESFUN16;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1, NUMBERS,
      VALUED_0, RELSET_1, MEASURE1, XXREAL_3, MEMBERED, XXREAL_2, SQUARE_1,
