      CARD_3, RELAT_1, ZFMISC_1, PRALG_1, ALGSTR_4, PARTFUN1, FUNCT_1, FUNCT_2,
      WAYBEL26, BINOP_1, FUNCT_4, FINSEQ_2, ENUMSET1, MSUALG_6, SYSREL,
      REWRITE1, FINSEQ_3, NAT_1, CARD_1, FUNCOP_1, FINSEQ_5, XTUPLE_0, GROUP_4,
      RELSET_1, FINSEQ_6, XXREAL_0, XREAL_1, INT_1, PRE_POLY, TOPREAL8, CHORD,
      NAT_D, ABCMIZ_0, XBOOLE_1, MSUALG_5, FUNCT_5, FUNCT_6, FUNCT_3, GROUP_6,
