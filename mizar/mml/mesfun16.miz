      NORMSP_1, PRVECT_3, RAT_1, MEASURE3, COMPLEX1, MEASURE5, FOMODEL0;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 equalities RCOMP_1, MEASUR10, BINOP_1, MESFUNC6, INTEGRA5, ALGSTR_0, NORMSP_0,
      PRVECT_3, SQUARE_1, DUALSP02, LOPBAN_5;
 expansions TARSKI, XBOOLE_0, MESFUNC1, MEASURE1, FCONT_1, MESFUNC6, INTEGRA5,
      NORMSP_1, NFCONT_1, NFCONT_2;
 theorems XBOOLE_0, FUNCT_1, XXREAL_0, XBOOLE_1, XXREAL_3, MEASURE1, VALUED_0,
      FUNCT_2, RELAT_1, MESFUNC5, EXTREAL1, PARTFUN1, MESFUNC1, MESFUNC2,
      MEASUR10, SUBSET_1, MEASUR11, MESFUN11, MESFUN12, RELSET_1, MESFUNC6,
