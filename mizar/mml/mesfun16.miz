      FCONT_1, FCONT_2, SUPINF_1, SUPINF_2, PROB_1, RCOMP_1, FINSUB_1,
      MEASURE1, MEASURE3, MEASURE5, MEASUR12, MESFUNC2, MESFUNC5, MESFUNC6,
      INTEGRA5, MEASURE8, MEASUR10, MEASUR11, MESFUN12, SEQ_1, SEQ_2, SEQ_4,
      STRUCT_0, ALGSTR_0, PRE_TOPC, NORMSP_0, NORMSP_1, NFCONT_1, LOPBAN_5,
      PRVECT_3, NFCONT_2, DUALSP02;
 constructors EXTREAL1, SUPINF_1, MESFUNC2, MEASUR11, MESFUN12, MESFUNC6,
